{
  "name": "@corsair-dev/rocketreach",
  "version": "0.1.0",
  "description": "RocketReach plugin for Corsair - person and company lookup and search, bulk lookup with status polling, and email verification",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build --force && tsup",
