{
  "name": "@corsair-dev/remarkety",
  "version": "0.1.0",
  "description": "Remarkety plugin for Corsair - manage stores and sync status, create contacts, build and update email campaigns with their rules and templates, and read products, rules and segments",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build --force && tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:live": "jest --testPathPattern=live"
  },
  "peerDependencies": {
    "corsair": ">=0.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "corsair": "workspace:*",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.1",
    "typescript": "catalog:",
    "zod": "^4.1.13"
  },
  "keywords": [
    "corsair",
    "remarkety",
    "ecommerce",
    "email-marketing",
    "campaigns",
    "automation",
    "plugin"
  ],
  "author": "Corsair (https://corsair.dev)",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corsairdev/corsair.git",
    "directory": "packages/remarkety"
  },
  "homepage": "https://docs.corsair.dev/plugins/remarkety"
}
