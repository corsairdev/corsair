  "description": "SEO data with Moz - read Domain Authority, Page Authority and Spam Score for sites, list backlinks, linking domains, anchor texts and top pages, find link intersects and ranking competitors, and check API quota.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build --force && tsup",
