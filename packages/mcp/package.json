{
  "name": "@corsair-dev/mcp",
  "version": "0.1.28",
  "description": "MCP server and framework adapters for Corsair. Expose 200+ integrations to any agent framework (Mastra, LangChain, LlamaIndex, OpenAI, Vercel AI, Claude) as tools.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "agent-tools",
    "tools",
    "tool-calling",
    "mastra",
    "langchain",
    "llamaindex",
    "openai",
    "anthropic",
    "claude",
    "vercel-ai",
    "oauth",
    "managed-oauth",
    "integrations",
    "corsair"
  ],
  "author": "Corsair (https://corsair.dev)",
  "license": "Apache-2.0",
  "homepage": "https://corsair.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corsairdev/corsair.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "corsair-mcp": "./dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mastra": {
      "dev-source": "./src/mastra.ts",
      "types": "./dist/mastra.d.ts",
      "default": "./dist/mastra.js"
    },
    "./langchain": {
      "dev-source": "./src/langchain.ts",
      "types": "./dist/langchain.d.ts",
      "default": "./dist/langchain.js"
    },
    "./llamaindex": {
      "dev-source": "./src/llamaindex.ts",
      "types": "./dist/llamaindex.d.ts",
      "default": "./dist/llamaindex.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.0",
    "@corsair-dev/langchain": "workspace:*",
    "@corsair-dev/llamaindex": "workspace:*",
    "@corsair-dev/mastra": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "corsair": "workspace:*",
    "express": "^4.21.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.2.0",
    "@anthropic-ai/sdk": ">=0.78.0",
    "@langchain/core": ">=1.0.0",
    "@llamaindex/core": ">=0.6.23",
    "@mastra/core": ">=1.64.0",
    "@openai/agents": ">=0.5.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@llamaindex/core": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "better-sqlite3": ">=11.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@langchain/core": "^1.0.0",
    "@llamaindex/core": "^0.6.23",
    "@mastra/core": "^1.64.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.8.0"
  },
  "files": [
    "dist"
  ]
}
