{
  "name": "@corsair-dev/studio",
  "version": "0.1.6",
  "description": "Local dashboard for inspecting and configuring your Corsair instance",
  "type": "module",
  "exports": {
    "./server": {
      "dev-source": "./src/server/index.ts",
      "types": "./dist/src/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vite build",
    "build:server": "tsup && tsc -p tsconfig.build.json",
    "dev:web": "vite",
    "dev:server": "tsx src/server/dev-entry.ts",
    "typecheck": "tsc --noEmit",
    "build:watch": "tsup --watch"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.25",
    "@ai-sdk/google": "^4.0.29",
    "@ai-sdk/groq": "^4.0.17",
    "@ai-sdk/openai": "^4.0.25",
    "@corsair-dev/cli": "workspace:*",
    "@corsair-dev/mcp": "workspace:*",
    "ai": "^7.0.44",
    "better-sqlite3": "^13.0.2",
    "corsair": "workspace:*",
    "kysely": "^0.29.4",
    "typescript": "^7.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.0.1",
    "tsx": "^4.23.1",
    "vite": "^8.2.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
