{
  "name": "@corsair-dev/endorsal",
  "version": "0.1.0",
  "description": "Manage Endorsal contacts, testimonials, tags, widgets, Wall of Love, and AutoRequest campaigns.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --build --force && tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathIgnorePatterns=api\\.test\\.ts",
    "test:live": "jest --testPathIgnorePatterns=/node_modules/ --testPathPattern=api\\.test\\.ts"
  },
  "peerDependencies": {
    "corsair": ">=0.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "corsair": "workspace:*",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.1",
    "typescript": "catalog:",
    "zod": "^4.1.13"
  },
  "keywords": [
    "corsair",
    "endorsal",
    "plugin"
  ],
  "author": "Corsair (https://corsair.dev)",
  "repository": {
    "type": "git",
    "url": "https://github.com/corsairdev/corsair.git",
    "directory": "packages/endorsal"
  },
