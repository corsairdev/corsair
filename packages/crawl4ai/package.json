{
  "name": "@corsair-dev/crawl4ai",
  "version": "0.1.0",
  "description": "Crawl4AI integration for Corsair: web crawling, both ways: a self-hosted Crawl4AI server (crawl to Markdown, HTML, screenshots and PDFs, JavaScript runs, crawl and LLM jobs, browser pool monitoring) and Crawl4AI Cloud (scrape, search, answer, Google SERP, extract, site scans and crawls, pricing pages, email verification, leads, page watches, 98 site tools, batch jobs, billing), plus job webhooks (66 operations).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build --force && tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:live": "jest --testPathIgnorePatterns=/node_modules/ --testPathPattern=api\\.test\\.ts"
  },
  "peerDependencies": {
    "corsair": ">=0.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "corsair": "workspace:*",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.1",
    "typescript": "catalog:",
    "zod": "^4.1.13"
  },
  "keywords": [
    "corsair",
    "crawl4ai",
    "crawler",
    "scraping",
    "markdown",
    "web-data",
    "plugin"
  ],
  "author": "Corsair (https://corsair.dev)",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corsairdev/corsair.git",
    "directory": "packages/crawl4ai"
  },
  "homepage": "https://docs.corsair.dev/plugins/crawl4ai"
}
