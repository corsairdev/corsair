  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corsairdev/corsair.git",
    "directory": "packages/segment"
  },
  "homepage": "https://docs.corsair.dev/plugins/segment"
}
