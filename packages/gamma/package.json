{
  "name": "@corsair-dev/gamma",
  "version": "0.1.0",
  "description": "Gamma plugin for Corsair: generate presentations, documents, webpages and social posts from text, read and search them, archive or delete them, export to PDF, PPTX or PNG, and browse the workspace's themes and folders.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build --force && tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "corsair": ">=0.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "corsair": "workspace:*",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.1",
    "typescript": "catalog:",
    "zod": "^4.1.13"
  },
  "keywords": [
    "corsair",
    "gamma",
    "plugin",
    "presentations",
    "ai-content"
  ],
  "author": "Corsair (https://corsair.dev)",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corsairdev/corsair.git",
    "directory": "packages/gamma"
  },
  "homepage": "https://docs.corsair.dev/plugins/gamma"
}
