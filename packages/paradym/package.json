{
  "name": "@corsair-dev/paradym",
  "version": "0.1.0",
  "description": "Paradym verifiable-credential infrastructure: manage wallets, SD-JWT VC credential and presentation templates, create OpenID4VC issuance offers and verification requests, batch-revoke credentials, and manage trusted entities and webhook subscriptions. Deliveries are HMAC-verified; DIDComm routes are not covered.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build --force && tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:live": "jest --testPathIgnorePatterns=/node_modules/ --testPathPattern=api\\.test\\.ts"
  },
  "peerDependencies": {
    "corsair": ">=0.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "corsair": "workspace:*",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.1",
    "typescript": "catalog:",
    "zod": "^4.1.13"
  },
  "keywords": [
    "corsair",
    "paradym",
    "plugin",
    "verifiable-credentials",
    "openid4vc"
  ],
  "author": "Ambikeeshh",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/corsairdev/corsair.git",
    "directory": "packages/paradym"
  },
  "homepage": "https://www.paradym.id"
}
