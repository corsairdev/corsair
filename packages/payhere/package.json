{
  "name": "@corsair-dev/payhere",
  "version": "0.1.0",
  "description": "Payhere is a Stripe-backed payment links platform. This plugin reads the account user, company and stats, lists customers, payments, plans and subscriptions, reads a customer with their payment history, issues full or partial refunds, and receives HMAC-verified payment and subscription webhooks.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build --force && tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:live": "jest --testPathIgnorePatterns=/node_modules/ --testPathPattern=api\\.test\\.ts"
  },
  "peerDependencies": {
    "corsair": ">=0.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "corsair": "workspace:*",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.1",
    "typescript": "catalog:",
    "zod": "^4.1.13"
  },
  "keywords": [
    "corsair",
    "payhere",
    "plugin",
    "payments",
    "stripe"
  ],
  "author": "Ambikeeshh",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/corsairdev/corsair.git",
    "directory": "packages/payhere"
  },
  "homepage": "https://payhere.co"
}
