{
  "name": "@corsair-dev/inkbox",
  "version": "0.1.0",
  "description": "Inkbox plugin for Corsair: give AI agents their own identities with email inboxes, phone numbers, SMS, calls, iMessage, WhatsApp and Slack, plus contacts, notes, an encrypted credential vault, tunnels, hosted agents and webhook events",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dev-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --build --force && tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:live": "jest --testPathIgnorePatterns=/node_modules/ --testPathPattern=api\\.test\\.ts"
  },
  "peerDependencies": {
    "corsair": ">=0.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "corsair": "workspace:*",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.1",
    "typescript": "catalog:",
    "zod": "^4.1.13"
  },
  "keywords": [
    "corsair",
    "inkbox",
    "agent-identity",
    "email",
    "sms",
    "imessage",
    "whatsapp",
    "plugin"
  ],
  "author": "Corsair (https://corsair.dev)",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corsairdev/corsair.git",
    "directory": "packages/inkbox"
  },
  "homepage": "https://docs.corsair.dev/plugins/inkbox"
}
