{
  "name": "@corsair/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:openapi": "rm -rf 'content/docs/(api)/v1' && bun scripts/generate-openapi.ts",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev --webpack",
    "dev:openapi": "pnpm generate:openapi && pnpm dev",
    "build": "pnpm generate:openapi && NODE_OPTIONS='--max-old-space-size=8192' next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-openapi": "12.0.4",
    "fumadocs-ui": "16.15.17",
    "mermaid": "^12.1.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.9.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.16",
    "typescript": "catalog:"
  }
}
