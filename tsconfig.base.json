
{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "incremental": true,
    "noErrorTruncation": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    "types": ["node", "bun"],

    // Keep TypeScript build output and cache files isolated
    // inside node_modules so other tools can ignore them.
    "outDir": "${configDir}/node_modules/.cache/ts/out",
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/ts/tsbuildinfo",

    // Enables IDEs to resolve development source files through
    // the "dev-source" package.json export condition.
    "customConditions": ["dev-source"],

    // Prevents filename casing inconsistencies across operating systems.
    "forceConsistentCasingInFileNames": true
  },

  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ],

  "include": [
    "./types.d.ts"
  ]
}
