            "optional": true,
            "type": "string"
          },
          {
            "key": "event",
            "optional": true,
            "type": "any"
          }
        ]
      },
      "responseType": "{ eventType: rangeUpdated, spreadsheetId: string, sheetName: string, range: string, values: (string | number | boolean | null)[], timestamp: string }",
      "usageExample": "googlesheets({\n    webhookHooks: {\n        rangeUpdated: {\n            before(ctx, args) {\n                return { ctx, args };\n            },\n            after(ctx, response) {\n            },\n        },\n    },\n})"
