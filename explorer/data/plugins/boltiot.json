      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "deviceName",
            "optional": false,
            "type": "string",
            "description": "The ID/Name of the Bolt IoT device"
          },
          {
            "key": "data",
            "optional": false,
            "type": "string",
            "description": "ASCII data string to send over UART"
