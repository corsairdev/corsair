{
  "id": "boltiot",
  "displayName": "Bolt IoT",
  "description": "IoT platform for connecting devices, sensors, and hardware to cloud dashboards.",
  "npmPackageName": "@corsair-dev/boltiot",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 7,
    "webhooks": 0,
    "db": 2
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature", "one"]
    }
  ],
  "api": [
    {
      "path": "boltiot.api.device.analogRead",
      "shortPath": "device.analogRead",
      "description": "Read the analog value (0-1023) from a specified pin on a Bolt device",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "deviceName",
            "optional": false,
            "type": "string",
            "description": "The ID/Name of the Bolt IoT device"
          },
          {
            "key": "pin",
            "optional": false,
            "type": "string",
            "description": "Analog pin to read from (e.g. A0)"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "success",
            "optional": false,
            "type": "boolean"
          },
          {
            "key": "value",
            "optional": false,
            "type": "number",
            "description": "Analog value reading (0-1023)"
          },
          {
            "key": "rawValue",
            "optional": false,
            "type": "string"
          },
          {
            "key": "pin",
            "optional": false,
            "type": "string"
          },
          {
            "key": "deviceName",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "boltiot.api.device.checkStatus",
      "shortPath": "device.checkStatus",
      "description": "Check whether a specified Bolt device is online",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "deviceName",
            "optional": false,
            "type": "string",
            "description": "The ID/Name of the Bolt IoT device (e.g. BOLT1234567)"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "success",
            "optional": false,
            "type": "boolean"
          },
          {
            "key": "value",
            "optional": false,
            "type": "string",
            "description": "Device status from isOnline: \"online\" or \"offline\""
          },
          {
            "key": "time",
            "optional": true,
            "type": "string",
            "description": "Official isOnline timestamp when that status last changed"
          },
          {
            "key": "deviceName",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "boltiot.api.device.digitalRead",
      "shortPath": "device.digitalRead",
      "description": "Read the status of a digital pin on a specified Bolt device",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "deviceName",
            "optional": false,
            "type": "string",
            "description": "The ID/Name of the Bolt IoT device"
          },
          {
            "key": "pin",
            "optional": false,
            "type": "string",
            "description": "Digital pin to read from (e.g. \"0\", \"1\", \"2\", \"3\", \"4\")"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "success",
            "optional": false,
            "type": "boolean"
          },
          {
            "key": "value",
            "optional": false,
            "type": "string",
            "description": "Digital pin state (\"1\" for HIGH, \"0\" for LOW)"
          },
          {
            "key": "pin",
            "optional": false,
            "type": "string"
          },
          {
            "key": "deviceName",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
