  "api": [
    {
      "path": "alibaba.api.image.generate",
      "shortPath": "image.generate",
      "description": "Generate or edit images with Qwen-Image 3.0 or Wan 2.7 Image; returns image URLs valid for 24 hours",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "model",
            "optional": false,
            "type": "qwen-image-3.0-pro | qwen-image-3.0 | wan2.7-image-pro | wan2.7-image"
          },
          {
            "key": "prompt",
            "optional": false,
            "type": "string"
          },
          {
            "key": "images",
            "optional": true,
            "type": "string[]"
          },
          {
            "key": "parameters",
            "optional": true,
            "type": "{ size?: string, n?: number, seed?: number, watermark?: boolean, negative_prompt?: string, prompt_extend?: boolean, prompt_extend_mode?: direct | agent, enable_thinking?: boolean, thinking_mode?: boolean, enable_sequential?: boolean, bbox_list?: tuple[][], color_palette?: { hex: string, ratio: string }[] }"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "output",
            "optional": false,
            "type": "{ rewrite_status?: string | null, choices: { finish_reason?: string | null, message: { role: string, content: { image: string }[] } }[] }"
          },
          {
            "key": "usage",
            "optional": true,
            "type": "{ output_width?: number | null, output_height?: number | null, input_image_count?: number | null, output_image_count?: number | null, input_image_type?: string | null, output_image_type?: string | null, width?: number | null, height?: number | null, image_count?: number | null }"
          },
          {
            "key": "request_id",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "alibaba.api.tasks.get",
      "shortPath": "tasks.get",
      "description": "Get a generation task status and, once it succeeds, the video URL (valid 24 hours)",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "task_id",
            "optional": false,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "output",
            "optional": false,
            "type": "{ task_id: string, task_status: PENDING | RUNNING | SUCCEEDED | FAILED | CANCELED | UNKNOWN, submit_time?: string | null, scheduled_time?: string | null, end_time?: string | null, video_url?: string | null, orig_prompt?: string | null, code?: string | null, message?: string | null }"
          },
          {
            "key": "usage",
            "optional": true,
            "type": "{ duration?: number | null, input_video_duration?: number | null, output_video_duration?: number | null, SR?: number | null, ratio?: string | null, video_count?: number | null }"
          },
          {
            "key": "request_id",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
