{
  "id": "brightdata",
  "displayName": "Bright Data",
  "description": "Web data platform for proxies, scraping, and collecting public internet datasets.",
  "npmPackageName": "@corsair-dev/brightdata",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 10,
    "webhooks": 0,
    "db": 9
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature", "one"]
    }
  ],
  "api": [
    {
      "path": "brightdata.api.crawlApi",
      "shortPath": "crawlApi",
      "description": "Tool to trigger an asynchronous site crawl for a dataset and list of URLs. Returns snapshot_id required by getSnapshotStatus and getSnapshotResults.",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "dataset_id",
            "optional": false,
            "type": "string",
            "description": "Official query: ?dataset_id="
          },
          {
            "key": "items",
            "optional": false,
            "type": "{}[]"
          },
          {
            "key": "include_errors",
            "optional": true,
            "type": "boolean"
          },
          {
            "key": "custom_output_fields",
            "optional": true,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "snapshot_id",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "brightdata.api.filterDataset",
      "shortPath": "filterDataset",
      "description": "Tool to apply custom filter criteria to a marketplace dataset (BETA). Use after selecting a dataset to generate a filtered snapshot.",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "dataset_id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "filter",
            "optional": false,
            "type": "{}"
          },
          {
            "key": "records_limit",
            "optional": true,
            "type": "number"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "snapshot_id",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "brightdata.api.getAvailableCities",
      "shortPath": "getAvailableCities",
      "description": "Tool to get available static network cities for a given country. Use when you need to configure static proxy endpoints after selecting a country.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "country",
            "optional": false,
            "type": "string",
            "description": "Official query: ?country="
          },
          {
            "key": "pool_ip_type",
            "optional": true,
            "type": "dc | static_res"
          }
        ]
      },
      "output": {
        "kind": "inline",
        "type": "string[]"
      }
    },
    {
      "path": "brightdata.api.getAvailableCountries",
      "shortPath": "getAvailableCountries",
      "description": "Tool to list available countries and their ISO 3166-1 alpha-2 codes. Use when you need to configure zones with valid country codes before provisioning proxies.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": []
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "zone_types",
            "optional": true,
            "type": "{}"
          }
        ]
      }
    },
    {
      "path": "brightdata.api.getSnapshotResults",
      "shortPath": "getSnapshotResults",
      "description": "Tool to retrieve the scraped data from a completed crawl job by snapshot ID. Only call after confirming the job is complete via getSnapshotStatus.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "snapshot_id",
            "optional": false,
            "type": "string",
            "description": "Official path {snapshot_id} on GET /datasets/v3/snapshot/{snapshot_id}"
          },
          {
            "key": "format",
            "optional": true,
            "type": "json | ndjson | jsonl | csv"
          },
          {
            "key": "compress",
            "optional": true,
            "type": "boolean"
          },
          {
            "key": "batch_size",
            "optional": true,
            "type": "number"
          },
          {
            "key": "part",
            "optional": true,
            "type": "number"
          }
        ]
      },
      "output": {
        "kind": "inline",
        "type": "{}[] | string"
      }
    },
    {
      "path": "brightdata.api.getSnapshotStatus",
      "shortPath": "getSnapshotStatus",
      "description": "Tool to check the processing status of a crawl job using snapshot ID. Call before attempting to download results to ensure data collection is complete.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "snapshot_id",
            "optional": false,
            "type": "string",
            "description": "Official path {snapshot_id} on GET /datasets/v3/progress/{snapshot_id}"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "snapshot_id",
            "optional": true,
            "type": "string"
          },
          {
            "key": "dataset_id",
            "optional": true,
            "type": "string"
          },
          {
            "key": "status",
            "optional": false,
            "type": "starting | running | ready | failed | canceled"
          }
        ]
      }
    },
    {
      "path": "brightdata.api.listDatasets",
      "shortPath": "listDatasets",
