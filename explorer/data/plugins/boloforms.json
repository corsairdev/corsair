{
  "id": "boloforms",
  "displayName": "BoloForms",
  "description": "Online form builder for surveys, applications, and lead capture with workflows.",
  "npmPackageName": "@corsair-dev/boloforms",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 1,
    "webhooks": 0,
    "db": 1
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature", "tenant_external_id"]
    }
  ],
  "api": [
    {
      "path": "boloforms.api.documents.list",
      "shortPath": "documents.list",
      "description": "Retrieve a list of documents from a Boloforms workspace, with optional filtering and pagination",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "workspaceId",
            "optional": false,
            "type": "string"
          },
          {
            "key": "query",
            "optional": true,
            "type": "string"
          },
          {
            "key": "sortOrder",
            "optional": true,
            "type": "string"
          },
          {
            "key": "limit",
            "optional": true,
            "type": "string"
          },
          {
            "key": "documentId",
            "optional": true,
            "type": "string"
          },
          {
            "key": "dateTo",
            "optional": true,
            "type": "string"
          },
          {
            "key": "dateFrom",
            "optional": true,
            "type": "string"
          },
          {
            "key": "page",
            "optional": true,
            "type": "string"
          },
          {
            "key": "sortBy",
            "optional": true,
            "type": "string"
          },
          {
            "key": "filter",
            "optional": true,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "documents",
            "optional": false,
            "type": "{ documentId: string, name?: string, documentName?: string, status?: string, signingType?: string, createdAt?: string, updatedAt?: string }[]"
          },
          {
            "key": "message",
            "optional": true,
            "type": "string"
          },
          {
            "key": "formCount",
            "optional": true,
            "type": "number"
          },
          {
            "key": "documentsCount",
            "optional": true,
            "type": "number"
          },
          {
            "key": "pagination",
            "optional": true,
            "type": "{ currentPage?: number, totalPages?: number, totalDocuments?: number }"
          }
        ]
      }
    }
  ],
  "webhooks": [],
  "db": [
    {
      "path": "boloforms.db.documents.search",
      "entityName": "documents",
      "filters": [
        {
          "field": "entity_id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "documentId",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "name",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "documentName",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "status",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "signingType",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "createdAt",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "updatedAt",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        }
      ]
    }
  ]
}
