{
  "id": "neverbounce",
  "displayName": "NeverBounce",
  "description": "Verify individual email addresses with the NeverBounce API.",
  "npmPackageName": "@corsair-dev/neverbounce",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 1,
    "webhooks": 0,
    "db": 0
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "neverbounce.api.single.check",
      "shortPath": "single.check",
      "description": "Verify one email address as it comes in, such as a form signup (valid, invalid, disposable, catchall or unknown); uses one verification credit. NeverBounce may lock the account if this is looped over an existing list; lists belong in its bulk jobs",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "email",
            "optional": false,
            "type": "string",
            "description": "Email address to verify, including invalid addresses for syntax checking"
          },
          {
            "key": "address_info",
            "optional": true,
            "type": "number",
            "description": "Include address details (default 0)"
          },
          {
            "key": "credits_info",
            "optional": true,
            "type": "number",
            "description": "Include credit details (default 0)"
          },
          {
            "key": "timeout",
            "optional": true,
            "type": "number",
            "description": "Maximum verification time in seconds"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "status",
            "optional": false,
            "type": "success"
          },
          {
            "key": "result",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "flags",
            "optional": true,
            "type": "string[] | null"
          },
          {
            "key": "suggested_correction",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "address_info",
            "optional": true,
            "type": "{ original_email?: string | null, normalized_email?: string | null, addr?: string | null, alias?: string | null, host?: string | null, fqdn?: string | null, domain?: string | null, subdomain?: string | null, tld?: string | null } | null"
          },
          {
            "key": "credits_info",
            "optional": true,
            "type": "{ paid_credits_used?: number | null, free_credits_used?: number | null, paid_credits_remaining?: number | null, free_credits_remaining?: number | null } | null"
          },
          {
            "key": "execution_time",
            "optional": true,
            "type": "number | null"
          }
        ]
      }
    }
  ],
  "webhooks": [],
  "db": []
}
