        "fields": [
          {
            "key": "model",
            "optional": false,
            "type": "sculptor | atelier"
          },
          {
            "key": "prompt",
            "optional": false,
            "type": "string"
          },
          {
            "key": "params",
            "optional": true,
            "type": "{ faces?: 200000 | 500000 | 1000000 | 2000000, pbr?: boolean, quad?: boolean, texture_quality?: standard | detailed }"
          },
          {
            "key": "outputs",
            "optional": true,
            "type": "glb | obj | stl | fbx[]"
          },
          {
            "key": "idempotencyKey",
            "optional": true,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "job_id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "status",
            "optional": false,
            "type": "string"
          },
          {
            "key": "created_at",
            "optional": false,
            "type": "string"
          },
          {
            "key": "billable_amount_cents",
            "optional": false,
            "type": "number"
          }
        ]
      }
    },
