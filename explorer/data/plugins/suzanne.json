{
  "id": "suzanne",
  "displayName": "Suzanne",
  "description": "Turn a text prompt or photos into a downloadable 3D mesh.",
  "npmPackageName": "@corsair-dev/suzanne",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 6,
    "webhooks": 0,
    "db": 1
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "suzanne.api.generations.photoTo3d",
      "shortPath": "generations.photoTo3d",
      "description": "Submit one to four photos and queue a 3D mesh job",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "model",
            "optional": false,
            "type": "sculptor | atelier | capture"
          },
          {
            "key": "images_upload_ids",
            "optional": true,
            "type": "{ front: string, back?: string, left?: string, right?: string }"
          },
          {
            "key": "images_inline",
            "optional": true,
            "type": "{ front: string }"
          },
          {
            "key": "params",
            "optional": true,
            "type": "{ faces?: 200000 | 500000 | 1000000 | 2000000, pbr?: boolean, quad?: boolean, texture_quality?: standard | detailed }"
          },
          {
            "key": "outputs",
            "optional": true,
            "type": "glb | obj | stl | fbx[]"
          },
          {
            "key": "idempotencyKey",
            "optional": true,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "job_id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "status",
            "optional": false,
            "type": "string"
          },
          {
            "key": "created_at",
            "optional": false,
            "type": "string"
          },
          {
            "key": "billable_amount_cents",
            "optional": false,
            "type": "number"
          }
        ]
      }
    },
    {
      "path": "suzanne.api.generations.textTo3d",
      "shortPath": "generations.textTo3d",
      "description": "Submit a text prompt and queue a 3D mesh job",
      "riskLevel": "write",
      "input": {
