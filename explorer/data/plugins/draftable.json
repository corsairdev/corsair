  "api": [
    {
      "path": "draftable.api.comparisons.create",
      "shortPath": "comparisons.create",
      "description": "Compare two documents given by URL (PDF, Word, PowerPoint, RTF or text). Uses one comparison from the plan quota.",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "left",
            "optional": false,
            "type": "{ source_url: string, file_type: pdf | docx | docm | doc | rtf | pptx | pptm | ppt | txt, display_name?: string }",
            "description": "The original document."
          },
          {
            "key": "right",
            "optional": false,
            "type": "{ source_url: string, file_type: pdf | docx | docm | doc | rtf | pptx | pptm | ppt | txt, display_name?: string }",
            "description": "The new document."
          },
          {
            "key": "identifier",
            "optional": true,
            "type": "string",
            "description": "Your own unique id for the comparison. Draftable makes one when omitted."
          },
          {
            "key": "public",
            "optional": true,
            "type": "boolean",
            "description": "Let anyone with the viewer link see it. Default false (signed links only)."
          },
          {
            "key": "expiry_time",
            "optional": true,
            "type": "string",
            "description": "ISO-8601 time after which Draftable deletes the comparison."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "identifier",
            "optional": false,
            "type": "string"
          },
          {
            "key": "comparison_type",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "viewer_url",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "left",
            "optional": true,
            "type": "{ file_type?: string | null, source_url?: string | null, display_name?: string | null, page_count?: number | null, original_document_size_bytes?: number | null, highlighted_document_size_bytes?: number | null } | null"
          },
          {
            "key": "right",
            "optional": true,
            "type": "{ file_type?: string | null, source_url?: string | null, display_name?: string | null, page_count?: number | null, original_document_size_bytes?: number | null, highlighted_document_size_bytes?: number | null } | null"
          },
          {
            "key": "creation_time",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "expiry_time",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "public",
            "optional": true,
            "type": "boolean | null"
          },
          {
            "key": "ready",
            "optional": true,
            "type": "boolean | null"
          },
          {
            "key": "ready_time",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "failed",
            "optional": true,
            "type": "boolean | null"
          },
          {
            "key": "error_message",
            "optional": true,
            "type": "string | null"
          }
        ]
      }
    },
