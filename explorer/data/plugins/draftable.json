    {
      "path": "draftable.api.comparisons.getViewerUrl",
      "shortPath": "comparisons.getViewerUrl",
      "description": "Get a link to view a comparison in the Draftable viewer, signed for a limited time unless the comparison is public.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "identifier",
            "optional": false,
            "type": "string",
            "description": "Comparison identifier from comparisons.list or comparisons.create."
          },
          {
            "key": "valid_for_minutes",
            "optional": true,
            "type": "number",
            "description": "How long a signed link stays valid. Default 30 minutes. Ignored for public comparisons."
          },
          {
            "key": "wait",
            "optional": true,
            "type": "boolean",
            "description": "Show a loading page until the comparison is ready instead of an error."
