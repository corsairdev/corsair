    {
      "path": "draftable.api.exports.create",
      "shortPath": "exports.create",
      "description": "Start a PDF export of a comparison. Poll exports.get until ready, then download its url.",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "comparison",
            "optional": false,
            "type": "string",
            "description": "Comparison identifier from comparisons.list or comparisons.create."
          },
          {
            "key": "kind",
            "optional": false,
            "type": "single_page | combined | left | right",
            "description": "single_page: the right document only, with highlights and deletion markers showing the changes; combined: both documents side by side; left or right: that document only."
          },
          {
            "key": "include_cover_page",
            "optional": true,
            "type": "boolean",
            "description": "Add a cover page (combined exports only)."
