{
  "id": "draftable",
  "displayName": "Draftable",
  "description": "Compare PDF, Word and PowerPoint documents with Draftable, view the differences and export them as PDF.",
  "npmPackageName": "@corsair-dev/draftable",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 7,
