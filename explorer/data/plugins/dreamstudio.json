          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        }
      ]
    },
    {
      "path": "dreamstudio.db.images.search",
      "entityName": "images",
      "filters": [
        {
          "field": "entity_id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "base64",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "seed",
          "type": "number",
          "operators": ["equals", "gt", "gte", "lt", "lte", "in"]
        }
      ]
    },
    {
      "path": "dreamstudio.db.organizations.search",
      "entityName": "organizations",
      "filters": [
        {
          "field": "entity_id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "name",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "role",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "is_default",
          "type": "boolean",
          "operators": ["equals"]
        }
      ]
    }
  ]
}
