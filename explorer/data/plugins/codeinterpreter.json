{
  "id": "codeinterpreter",
  "displayName": "CodeInterpreter",
  "description": "CodeInterpreter plugin for Corsair",
  "npmPackageName": "@corsair-dev/codeinterpreter",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 5,
    "webhooks": 0,
    "db": 3
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": [
        "api_key",
        "webhook_signature",
        "session_id",
        "tenant_external_id"
      ]
    }
  ],
  "api": [
    {
      "path": "codeinterpreter.api.code.execute",
      "shortPath": "code.execute",
      "description": "Execute code in the sandbox",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "code",
            "optional": false,
            "type": "string"
          },
          {
            "key": "language",
            "optional": true,
            "type": "string"
          },
          {
            "key": "session_id",
            "optional": true,
            "type": "string"
          },
          {
            "key": "args",
            "optional": true,
            "type": "string[]"
          },
          {
            "key": "files",
            "optional": true,
            "type": "string[]"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "exit_code",
            "optional": false,
            "type": "number"
          },
          {
            "key": "stdout",
            "optional": true,
            "type": "string"
          },
          {
            "key": "stderr",
            "optional": true,
            "type": "string"
          },
          {
            "key": "logs",
            "optional": true,
            "type": "string"
          },
          {
            "key": "output_files",
            "optional": true,
            "type": "{ id: string, name: string }[]"
          },
          {
            "key": "session_id",
            "optional": true,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "codeinterpreter.api.file.delete",
      "shortPath": "file.delete",
      "description": "Delete a file from the sandbox",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "file_id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "session_id",
            "optional": true,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "success",
            "optional": false,
            "type": "boolean"
          },
          {
            "key": "file_id",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "codeinterpreter.api.file.download",
      "shortPath": "file.download",
      "description": "Download a file from the sandbox",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "file_id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "session_id",
            "optional": true,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "file_id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "filename",
            "optional": true,
            "type": "string"
          },
          {
            "key": "content",
            "optional": false,
            "type": "string"
          },
          {
            "key": "mime_type",
            "optional": true,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "codeinterpreter.api.file.list",
      "shortPath": "file.list",
      "description": "List files in the sandbox",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "session_id",
            "optional": true,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "files",
            "optional": false,
            "type": "{ id: string, name: string, size?: number, mime_type?: string }[]"
          }
        ]
      }
    },
    {
      "path": "codeinterpreter.api.file.upload",
      "shortPath": "file.upload",
      "description": "Upload a file to the sandbox",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "filename",
            "optional": false,
            "type": "string"
          },
          {
            "key": "content",
            "optional": false,
            "type": "string"
          },
          {
            "key": "content_encoding",
            "optional": true,
            "type": "utf8 | base64"
          },
          {
            "key": "session_id",
            "optional": true,
            "type": "string"
          },
          {
            "key": "mime_type",
            "optional": true,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "file_id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "filename",
            "optional": false,
            "type": "string"
          },
          {
            "key": "size",
            "optional": true,
            "type": "number"
          },
          {
            "key": "session_id",
            "optional": true,
            "type": "string"
          }
        ]
      }
    }
  ],
  "webhooks": [],
  "db": [
    {
      "path": "codeinterpreter.db.executions.search",
      "entityName": "executions",
      "filters": [
        {
          "field": "entity_id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "exit_code",
          "type": "number",
          "operators": ["equals", "gt", "gte", "lt", "lte", "in"]
        },
        {
          "field": "stdout",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "stderr",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "logs",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "session_id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "created_at",
          "type": "date",
          "operators": ["equals", "before", "after", "between"]
        }
      ]
    },
    {
      "path": "codeinterpreter.db.files.search",
      "entityName": "files",
      "filters": [
        {
          "field": "entity_id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "name",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "size",
          "type": "number",
          "operators": ["equals", "gt", "gte", "lt", "lte", "in"]
        },
        {
          "field": "mime_type",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "session_id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "created_at",
          "type": "date",
          "operators": ["equals", "before", "after", "between"]
        }
      ]
    },
    {
      "path": "codeinterpreter.db.sessions.search",
      "entityName": "sessions",
      "filters": [
        {
          "field": "entity_id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "language",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "created_at",
          "type": "date",
          "operators": ["equals", "before", "after", "between"]
        },
        {
          "field": "updated_at",
          "type": "date",
          "operators": ["equals", "before", "after", "between"]
        }
      ]
    }
  ]
}
