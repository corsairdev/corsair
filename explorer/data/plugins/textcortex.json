          },
          {
            "key": "query",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "website",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "limit",
            "optional": true,
            "type": "number | null"
          },
          {
            "key": "data",
            "optional": false,
            "type": "{ object?: string | null, url?: string | null, snippet?: string | null, score?: number | null, published_at?: string | null }[]"
          },
          {
            "key": "usage",
            "optional": true,
            "type": "{ billing?: string | null, cost?: number | null, currency?: string | null } | null"
