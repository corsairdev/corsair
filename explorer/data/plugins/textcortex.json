            "type": "{ id: string, created?: number | null, object?: string | null, owned_by?: string | null }[]"
          }
        ]
      }
    },
    {
      "path": "textcortex.api.responses.create",
      "shortPath": "responses.create",
      "description": "Generate one response from a prompt and optional instructions, which spends credits",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "model",
            "optional": false,
            "type": "string",
            "description": "A model ID from `models.list`. Use the base ID; `-thinking` variants are deprecated."
          },
          {
            "key": "input",
