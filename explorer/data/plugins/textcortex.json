    {
      "path": "textcortex.api.chat.completions",
      "shortPath": "chat.completions",
      "description": "Generate a chat completion from a conversation, which spends credits on every call",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "model",
            "optional": false,
            "type": "string",
            "description": "A model ID from `models.list`. Use the base ID and set `reasoning_effort` rather than a `-thinking` variant, which is deprecated."
          },
          {
            "key": "messages",
            "optional": false,
            "type": "{ role: system | user | assistant | tool, content: string, name?: string }[]",
            "description": "The conversation, oldest first."
          },
          {
            "key": "max_tokens",
            "optional": true,
            "type": "number",
            "description": "Cap the tokens generated."
          },
          {
            "key": "temperature",
            "optional": true,
            "type": "number",
            "description": "Sampling temperature, 0 to 2."
          },
          {
            "key": "top_p",
            "optional": true,
            "type": "number",
            "description": "Nucleus sampling probability, 0 to 1."
          },
          {
            "key": "n",
            "optional": true,
            "type": "number",
            "description": "How many completions to generate."
          },
          {
            "key": "stop",
            "optional": true,
            "type": "string | string[]",
            "description": "A stop sequence, or a list of them."
          },
          {
            "key": "presence_penalty",
            "optional": true,
            "type": "number"
          },
          {
            "key": "frequency_penalty",
            "optional": true,
            "type": "number"
          },
          {
            "key": "seed",
            "optional": true,
            "type": "number",
            "description": "A seed for reproducible output."
          },
          {
            "key": "user",
            "optional": true,
            "type": "string",
            "description": "A caller-side user identifier for abuse tracking."
          },
          {
            "key": "reasoning_effort",
            "optional": true,
            "type": "none | low | medium | high",
            "description": "How much reasoning the model should spend, for models that grade it."
          },
          {
            "key": "response_format",
            "optional": true,
            "type": "{ type: string }",
            "description": "Ask for a structured answer, e.g. `{ type: \"json_object\" }`."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "object",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "created",
            "optional": true,
            "type": "number | null"
          },
          {
            "key": "model",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "choices",
            "optional": false,
            "type": "{ index?: number | null, finish_reason?: string | null, message?: { role?: string | null, content?: string | any[] | null } | null }[]"
          },
          {
            "key": "usage",
            "optional": true,
            "type": "{ completion_tokens?: number | null, prompt_tokens?: number | null, total_tokens?: number | null, prompt_tokens_details?: { cached_tokens?: number | null } | null } | null"
          }
        ]
      }
    },
    {
      "path": "textcortex.api.images.create",
      "shortPath": "images.create",
      "description": "Generate an image from a prompt, returning its URL, and spend credits per image",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "prompt",
            "optional": false,
            "type": "string",
            "description": "What the image should show."
          },
          {
            "key": "model",
            "optional": true,
            "type": "string",
            "description": "An image model ID. The API picks its default when omitted."
          },
          {
            "key": "n",
            "optional": true,
            "type": "1",
            "description": "How many images to generate. TextCortex accepts only 1."
          },
          {
            "key": "size",
            "optional": true,
            "type": "string",
            "description": "The output size as \"WIDTHxHEIGHT\", e.g. \"1024x1024\"."
          },
          {
            "key": "response_format",
            "optional": true,
            "type": "url",
            "description": "TextCortex returns a URL only; base64 is not offered."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "created",
            "optional": true,
            "type": "number | null"
          },
          {
            "key": "data",
            "optional": false,
            "type": "{ url?: string | null, image_id?: string | null, model?: string | null, file_type?: string | null, width?: number | null, height?: number | null, revised_prompt?: string | null }[]"
          }
        ]
      }
    },
