            "type": "string",
            "description": "The prompt or conversation text."
          },
          {
            "key": "instructions",
            "optional": true,
            "type": "string",
            "description": "A system instruction that applies to the whole response."
          },
          {
            "key": "max_output_tokens",
            "optional": true,
            "type": "number"
          },
          {
            "key": "temperature",
            "optional": true,
            "type": "number"
          },
          {
            "key": "top_p",
            "optional": true,
            "type": "number"
          },
          {
            "key": "store",
            "optional": true,
            "type": "false",
            "description": "TextCortex requires this to be false, since it stores no conversation."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
