          },
          {
            "key": "output",
            "optional": true,
            "type": "{ type?: string | null, text?: string | null, id?: string | null, role?: string | null, status?: string | null, content?: { type?: string | null, text?: string | null }[] | null }[] | null"
          },
          {
            "key": "incomplete_details",
            "optional": true,
            "type": "{ reason?: string | null } | null"
          },
          {
            "key": "output_text",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "usage",
            "optional": true,
            "type": "{ input_tokens?: number | null, output_tokens?: number | null, total_tokens?: number | null } | null"
          }
        ]
      }
    },
    {
      "path": "textcortex.api.web.search",
      "shortPath": "web.search",
      "description": "Search the web and return matching sources with snippets; each search spends credits",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "query",
            "optional": false,
            "type": "string",
            "description": "What to search for."
          },
          {
            "key": "limit",
            "optional": true,
            "type": "number",
            "description": "How many results to return, 1 to 10; TextCortex defaults to 5."
          },
          {
            "key": "website",
            "optional": true,
            "type": "string",
            "description": "Only return results from this website, e.g. \"example.com\"."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "object",
            "optional": true,
