    {
      "path": "mem0.api.memories.add",
      "shortPath": "memories.add",
      "description": "Extract memories from conversation messages and store them for a user, agent, app or run; processing is queued and returns an event_id to poll",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "messages",
            "optional": false,
            "type": "{ role: user | assistant | system, content: string }[]",
            "description": "Conversation turns for Mem0 to extract memories from."
          },
          {
            "key": "user_id",
            "optional": true,
            "type": "string",
            "description": "Scope memories to this user."
          },
          {
            "key": "agent_id",
            "optional": true,
            "type": "string",
            "description": "Scope memories to this agent."
          },
          {
            "key": "app_id",
            "optional": true,
            "type": "string",
            "description": "Scope memories to this app."
          },
          {
            "key": "run_id",
            "optional": true,
            "type": "string",
            "description": "Scope memories to this run."
          },
          {
            "key": "metadata",
            "optional": true,
            "type": "Record<string, any>",
            "description": "Custom key/value metadata attached to each memory."
          },
          {
            "key": "infer",
            "optional": true,
            "type": "boolean",
            "description": "Defaults to true, which runs extraction. Set false to store each message verbatim, which also makes the response synchronous."
          },
          {
            "key": "expiration_date",
            "optional": true,
            "type": "string",
            "description": "Date through which the memory is visible. Expired memories are hidden unless `show_expired` is passed."
          },
          {
            "key": "immutable",
            "optional": true,
            "type": "boolean",
            "description": "Defaults to false. Immutable memories are excluded from later update and consolidation."
          },
          {
            "key": "includes",
            "optional": true,
            "type": "string",
            "description": "Free-text hint of what to include during extraction."
          },
          {
            "key": "excludes",
            "optional": true,
            "type": "string",
            "description": "Free-text hint of what to exclude during extraction."
          },
          {
            "key": "enable_graph",
            "optional": true,
            "type": "boolean",
            "description": "Enable graph memory extraction for this call."
          },
          {
            "key": "timestamp",
            "optional": true,
            "type": "number",
            "description": "Unix epoch seconds used as the created_at of stored memories."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "event_id",
            "optional": true,
            "type": "string | null",
            "description": "Poll this with events.get."
          },
          {
            "key": "status",
            "optional": true,
            "type": "string | null",
            "description": "PENDING when extraction is queued, SUCCEEDED when `infer` was false."
          },
          {
            "key": "message",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "results",
            "optional": true,
            "type": "{ id?: string | null, data?: Record<string, any> | null, event?: string | null }[] | null"
          }
        ]
      }
    },
