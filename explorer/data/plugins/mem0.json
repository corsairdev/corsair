    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "mem0.api.events.get",
      "shortPath": "events.get",
      "description": "Read one queued event by ID to see whether an add or delete finished, failed, or is still running",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "event_id",
            "optional": false,
            "type": "string",
            "description": "The event_id returned by memories.add or memories.deleteAll."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "event_type",
            "optional": true,
            "type": "string | null",
            "description": "ADD, SEARCH, DELETE_ALL and so on."
          },
          {
            "key": "status",
            "optional": true,
            "type": "string | null",
            "description": "PENDING, RUNNING, FAILED or SUCCEEDED."
          },
          {
            "key": "payload",
            "optional": true,
            "type": "Record<string, any> | null"
          },
          {
            "key": "metadata",
            "optional": true,
            "type": "Record<string, any> | null"
          },
          {
            "key": "results",
            "optional": true,
            "type": "any[] | Record<string, any> | null",
            "description": "An array for ADD, SEARCH and GET_ALL, one object for UPDATE, and null for a delete."
          },
          {
            "key": "created_at",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "updated_at",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "started_at",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "completed_at",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "latency",
            "optional": true,
            "type": "number | null",
            "description": "Processing time in milliseconds."
          },
          {
            "key": "graph_status",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "error",
            "optional": true,
            "type": "string | null"
          }
        ]
      }
    },
