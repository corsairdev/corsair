          },
          {
            "key": "fields",
            "optional": true,
            "type": "string[]",
            "description": "Only these fields come back per memory. A memory without them is absent from the result, not null."
          },
          {
            "key": "keywords",
            "optional": true,
            "type": "string",
            "description": "Free-text keyword filter applied on top of `filters`."
