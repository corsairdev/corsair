{
  "id": "mem0",
  "displayName": "Mem0",
  "description": "Long-term memory for AI agents with Mem0 - add, search, list, update and delete memories, read a memory's change history, and poll the events Mem0 queues for asynchronous work.",
  "npmPackageName": "@corsair-dev/mem0",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 16,
    "webhooks": 0,
    "db": 0
