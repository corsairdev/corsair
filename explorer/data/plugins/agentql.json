      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "data",
            "optional": false,
            "type": "{}"
          },
          {
            "key": "metadata",
            "optional": true,
            "type": "{ request_id?: string, generated_query?: string | null }"
          }
        ]
      }
    },
    {
      "path": "agentql.api.usage.get",
      "shortPath": "usage.get",
      "description": "Retrieves API usage statistics and subscription limits for the AgentQL account. Returns current billing cycle dates, lifetime usage limits, API key usage counts, and total account usage. Useful for monitoring quota consumption and planning usage. No parameters required - uses the authenticated API key from connection settings.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": []
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "data",
            "optional": false,
            "type": "{ current_subscription?: { lifetime_usage_limit?: number | null, current_cycle_free_usage_limit?: number | null, current_cycle_start?: string, current_cycle_end?: string } | null, api_key_usage: { current_cycle?: number | null, lifetime?: number }, total_account_usage: { current_cycle?: number | null, lifetime?: number } }"
          },
          {
            "key": "metadata",
            "optional": true,
            "type": "{ request_id?: string }"
          }
        ]
      }
    }
  ],
