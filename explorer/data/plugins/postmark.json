      "path": "postmark.api.email.send",
      "shortPath": "email.send",
      "description": "Send one transactional email. This delivers a real message and cannot be recalled once Postmark accepts it",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "From",
            "optional": false,
            "type": "string",
            "description": "The sender. The address needs a confirmed Sender Signature or a verified domain."
          },
          {
            "key": "To",
            "optional": false,
            "type": "string",
            "description": "Comma-separated addresses. `To`, `Cc` and `Bcc` together allow 50, and each address is at most 254 characters."
          },
          {
            "key": "Cc",
            "optional": true,
            "type": "string",
            "description": "Comma-separated addresses. `To`, `Cc` and `Bcc` together allow 50, and each address is at most 254 characters."
          },
          {
            "key": "Bcc",
            "optional": true,
            "type": "string",
            "description": "Comma-separated addresses. `To`, `Cc` and `Bcc` together allow 50, and each address is at most 254 characters."
          },
          {
            "key": "Subject",
            "optional": true,
            "type": "string",
            "description": "Max 2000 characters."
          },
          {
            "key": "Tag",
            "optional": true,
            "type": "string",
            "description": "Categorises the message for statistics."
          },
          {
            "key": "HtmlBody",
            "optional": true,
            "type": "string"
          },
          {
            "key": "TextBody",
            "optional": true,
            "type": "string"
          },
          {
            "key": "ReplyTo",
            "optional": true,
            "type": "string",
            "description": "Comma-separated addresses. `To`, `Cc` and `Bcc` together allow 50, and each address is at most 254 characters."
          },
          {
            "key": "Headers",
            "optional": true,
            "type": "{ Name: string, Value: string }[]",
            "description": "Custom headers to include."
          },
          {
            "key": "TrackOpens",
            "optional": true,
            "type": "boolean"
          },
          {
            "key": "TrackLinks",
            "optional": true,
            "type": "None | HtmlAndText | HtmlOnly | TextOnly",
            "description": "Which bodies get their links rewritten for tracking."
          },
          {
            "key": "Attachments",
            "optional": true,
            "type": "{ Name: string, Content: string, ContentType: string, ContentID?: string }[]"
          },
          {
            "key": "Metadata",
            "optional": true,
            "type": "Record<string, string>"
          },
          {
            "key": "MessageStream",
            "optional": true,
            "type": "string",
            "description": "Defaults to the `outbound` transactional stream."
