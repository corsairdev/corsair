      "path": "u301.api.links.create",
      "shortPath": "links.create",
      "description": "Shorten a URL on u301.co or one of your domains, with an optional custom slug, password and comment; a new link spends one monthly allowance slot",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "url",
            "optional": false,
            "type": "string",
            "description": "The destination URL to shorten."
          },
          {
            "key": "domain",
            "optional": true,
            "type": "string",
            "description": "The domain for the link, such as u301.co or one of your own."
          },
          {
            "key": "slug",
            "optional": true,
            "type": "string",
            "description": "A custom path. A random one is generated when omitted."
          },
          {
            "key": "reuseExisting",
            "optional": true,
            "type": "boolean",
            "description": "Reuse an existing short link when the same URL is already shortened, instead of creating a second one."
          },
          {
            "key": "password",
            "optional": true,
            "type": "string",
            "description": "Require this password before the short link resolves."
          },
          {
            "key": "comment",
            "optional": true,
            "type": "string",
            "description": "A note to attach to the link."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "url",
            "optional": true,
            "type": "string | null",
            "description": "The destination URL."
          },
          {
            "key": "slug",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "isCustomSlug",
            "optional": true,
            "type": "boolean | null"
          },
          {
            "key": "domain",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "isReused",
            "optional": true,
            "type": "boolean | null",
            "description": "True when an existing link was returned and no new one was created."
          },
          {
            "key": "shortLink",
            "optional": true,
            "type": "string | null",
            "description": "The short link without a scheme, such as u301.co/jtyZ."
          },
          {
            "key": "comment",
            "optional": true,
            "type": "string | null"
          }
        ]
      }
