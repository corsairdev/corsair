    {
      "path": "u301.api.analytics.audience",
      "shortPath": "analytics.audience",
      "description": "Read a top-N click breakdown by country, city, referrer, browser, OS or device",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "dimension",
            "optional": false,
            "type": "countries | cities | referers | browsers | operating-systems | device-types",
            "description": "Which breakdown to read: countries, cities, referers, browsers, operating-systems or device-types."
          },
          {
            "key": "range",
            "optional": false,
            "type": "24h | 1d | 3d | 7d | 14d | 30d | 60d | 1m",
            "description": "The window to aggregate over."
          },
          {
            "key": "timezone",
            "optional": true,
            "type": "string",
            "description": "An IANA timezone for the buckets. Defaults to UTC."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "datetimeRange",
            "optional": true,
            "type": "string[] | null"
          },
          {
            "key": "range",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "data",
            "optional": true,
            "type": "{ label?: string | null, click?: number | null, meta?: Record<string, any> | null }[] | null"
          }
        ]
      }
    },
    {
      "path": "u301.api.analytics.clicks",
      "shortPath": "analytics.clicks",
      "description": "Read click counts over a time range at a chosen granularity, in a chosen timezone",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "range",
            "optional": false,
            "type": "24h | 1d | 3d | 7d | 14d | 30d | 60d | 1m",
            "description": "The window to aggregate over."
          },
          {
            "key": "granularity",
            "optional": false,
            "type": "day | hour",
            "description": "The bucket size within that window."
          },
          {
            "key": "timezone",
            "optional": true,
            "type": "string",
            "description": "An IANA timezone for the buckets. Defaults to UTC."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "start",
            "optional": true,
            "type": "string | null",
            "description": "ISO 8601 start of the window."
          },
          {
            "key": "end",
            "optional": true,
            "type": "string | null",
            "description": "ISO 8601 end of the window."
          },
          {
            "key": "data",
            "optional": true,
            "type": "{ date?: string | null, click?: number | null }[] | null",
            "description": "One entry per bucket."
          }
        ]
      }
    },
