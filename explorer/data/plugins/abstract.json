      "path": "abstract.api.email.reputation",
      "shortPath": "email.reputation",
      "description": "Assess email deliverability and quality: format, disposable/free/role detection, MX and SMTP validation",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "email",
            "optional": false,
            "type": "string",
            "description": "The email address to check the reputation of"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "email_address",
            "optional": false,
            "type": "string"
          },
          {
            "key": "suggested_correction",
            "optional": true,
            "type": "string"
          },
          {
            "key": "email_deliverability",
            "optional": false,
            "type": "{ status: string, status_detail: string, is_format_valid: boolean, is_smtp_valid: boolean, is_mx_valid: boolean, mx_records?: string[] | null }"
          },
          {
            "key": "email_quality",
            "optional": false,
            "type": "{ score: number, is_free_email: boolean, is_username_suspicious: boolean, is_disposable: boolean, is_catchall: boolean, is_subaddress: boolean, is_role?: boolean, is_dmarc_enforced?: boolean, is_spf_strict?: boolean, minimum_age?: number | null }"
          },
          {
            "key": "email_sender",
            "optional": false,
            "type": "{ first_name?: string | null, last_name?: string | null, email_provider_name?: string | null, organization_name?: string | null, organization_type?: string | null }"
          },
          {
            "key": "email_domain",
            "optional": false,
            "type": "{ domain?: string | null, domain_age?: number | null, is_live_site?: boolean | null, registrar?: string | null, registrar_url?: string | null, date_registered?: string | null, date_last_renewed?: string | null, date_expires?: string | null, is_risky_tld?: boolean | null }"
          },
          {
            "key": "email_risk",
            "optional": false,
            "type": "{ address_risk_status?: string | null, domain_risk_status?: string | null }"
          },
          {
            "key": "email_breaches",
            "optional": true,
            "type": "{ total_breaches?: number | null, date_first_breached?: string | null, date_last_breached?: string | null, breached_domains?: { domain: string, breach_date?: string | null }[] }"
          }
        ]
      }
