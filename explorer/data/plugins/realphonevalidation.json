    {
      "path": "realphonevalidation.api.dncLookup",
      "shortPath": "dncLookup",
      "description": "Check a US phone number against the national, state and DMA Do-Not-Call lists and the known-litigator list, and report its line type. Needs a SAN number from the national registry",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "phone",
            "optional": false,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "RESPONSECODE",
            "optional": true,
            "type": "string | null",
            "description": "OK, or -1, 102 or invalid-phone for a refusal."
          },
          {
            "key": "RESPONSEMSG",
            "optional": true,
            "type": "string | Record<string, never> | null",
            "description": "An error string, or {} when there is no error."
          },
          {
            "key": "national_dnc",
            "optional": true,
            "type": "string | null",
            "description": "Y is on the list, N is not, ? means a timeout or an unchecked list. Treat ? as unknown, not as cleared."
          },
          {
            "key": "state_dnc",
            "optional": true,
            "type": "string | null",
            "description": "Y is on the list, N is not, ? means a timeout or an unchecked list. Treat ? as unknown, not as cleared."
          },
          {
            "key": "dma",
            "optional": true,
            "type": "string | null",
            "description": "Y is on the list, N is not, ? means a timeout or an unchecked list. Treat ? as unknown, not as cleared."
          },
          {
            "key": "litigator",
            "optional": true,
            "type": "string | null",
            "description": "Y, N or ? for a known TCPA litigator or serial plaintiff."
          },
          {
            "key": "iscell",
            "optional": true,
            "type": "string | null",
            "description": "Y cell, N landline, V VoIP."
          },
          {
            "key": "id",
            "optional": true,
            "type": "string | null",
            "description": "An internal identifier."
          }
        ]
