      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "RESPONSECODE",
            "optional": true,
            "type": "string | null",
            "description": "L active landline, C active cell, V active VoIP, N inactive."
          },
          {
            "key": "RESPONSEMSG",
            "optional": true,
            "type": "string | Record<string, never> | null",
            "description": "An error string, or {} when there is no error."
          }
        ]
      }
