{
  "id": "fal",
  "displayName": "fal",
  "description": "Generative media platform with hundreds of image, video, audio and 3D models; queue or run models, follow requests, look up models and prices, track usage and upload input files.",
  "npmPackageName": "@corsair-dev/fal",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 14,
    "webhooks": 1,
    "db": 0
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature", "user_id"]
    }
  ],
