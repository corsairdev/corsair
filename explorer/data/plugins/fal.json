      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "models",
            "optional": false,
            "type": "{ endpoint_id: string, metadata?: { display_name?: string, category?: string, description?: string, status?: string, tags?: string[], updated_at?: string, thumbnail_url?: string, model_url?: string, license_type?: string, kind?: string, duration_estimate?: number | null }, retires_at?: string | null, replacement?: string | null, openapi?: Record<string, any> }[]"
          },
          {
            "key": "next_cursor",
            "optional": true,
