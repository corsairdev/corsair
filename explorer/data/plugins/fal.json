    {
      "path": "fal.api.models.run",
      "shortPath": "models.run",
      "description": "Run a model and wait up to waitSeconds (default 10) for its output; spends fal credits. SUCCEEDED and FAILED are final. IN_QUEUE or IN_PROGRESS is a job to follow with queue.status; video, audio and training usually take longer than the wait.",
      "riskLevel": "write",
      "job": {
        "idPath": "response_url",
        "status": {
          "op": "queue.status",
          "idArg": "responseUrl",
          "statusPath": "state",
          "done": ["SUCCEEDED"],
          "failed": ["FAILED"]
        },
        "cancel": {
          "op": "queue.cancel",
          "idArg": "responseUrl"
        }
      },
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "endpointId",
            "optional": false,
            "type": "string",
            "description": "fal model endpoint id, for example fal-ai/flux/schnell or fal-ai/kling-video/v2.1/master/text-to-video. Find ids with models.search."
          },
          {
            "key": "input",
            "optional": false,
            "type": "Record<string, any>",
            "description": "The model's input fields, for example { prompt: 'a lighthouse at dawn' }. Each model has its own; read them with models.search({ endpointIds: [id], includeOpenApi: true })."
          },
          {
            "key": "webhookUrl",
            "optional": true,
            "type": "string",
            "description": "An https URL fal POSTs the result to when the request completes (signed; see the requests.completed webhook)."
          },
          {
            "key": "priority",
            "optional": true,
            "type": "normal | low",
            "description": "low puts it behind your other requests to this endpoint."
          },
          {
            "key": "startTimeout",
            "optional": true,
            "type": "number",
            "description": "Seconds fal may wait for a runner before giving up (504). Does not limit run time."
          },
          {
            "key": "hint",
            "optional": true,
            "type": "string",
            "description": "Routing hint: requests with the same hint go to the same runner."
          },
          {
            "key": "noRetry",
            "optional": true,
            "type": "boolean",
            "description": "true turns off fal’s automatic retries for this request."
          },
          {
            "key": "maxQueueLength",
            "optional": true,
            "type": "number",
            "description": "Reject with 429 if this many requests are already queued."
          },
          {
            "key": "waitSeconds",
            "optional": true,
            "type": "number",
            "description": "How long models.run waits after submitting, default 10 and at most 15 seconds."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "status",
            "optional": false,
            "type": "string",
            "description": "fal's raw queue status: IN_QUEUE, IN_PROGRESS or COMPLETED. A failed or cancelled request is COMPLETED too, so read `state` for the outcome."
          },
          {
            "key": "request_id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "response_url",
            "optional": false,
            "type": "string",
            "description": "Pass to queue.status as responseUrl to follow a run still going."
          },
          {
            "key": "status_url",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "cancel_url",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "queue_position",
            "optional": true,
            "type": "number | null"
          },
          {
            "key": "logs",
            "optional": true,
            "type": "{ message: string, timestamp: string, level?: string, labels?: Record<string, any> }[] | null"
          },
          {
            "key": "metrics",
            "optional": true,
            "type": "{ inference_time?: number | null } | null"
          },
          {
            "key": "error",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "error_type",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "state",
            "optional": false,
            "type": "IN_QUEUE | IN_PROGRESS | SUCCEEDED | FAILED",
            "description": "IN_QUEUE or IN_PROGRESS while it runs; SUCCEEDED with output, or FAILED with error, once it is done."
          },
          {
            "key": "output",
            "optional": true,
            "type": "Record<string, any>",
            "description": "The model output. Its shape is model-specific: image models return images[].url, video models video.url, audio models audio.url. fal media URLs expire, so save files you want to keep."
          }
        ]
      }
    },
    {
      "path": "fal.api.models.search",
      "shortPath": "models.search",
      "description": "Find fal models by text, category or endpoint id; includeOpenApi returns their input and output fields",
