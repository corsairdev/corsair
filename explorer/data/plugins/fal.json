    {
      "path": "fal.api.queue.cancel",
      "shortPath": "queue.cancel",
      "description": "Cancel a queued request: removed if still waiting, asked to stop if running",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "endpointId",
            "optional": true,
            "type": "string",
            "description": "The endpoint id the request was submitted to. Pass it with requestId."
          },
          {
            "key": "requestId",
            "optional": true,
            "type": "string",
            "description": "The request_id queue.submit returned. Pass it with endpointId."
          },
          {
            "key": "responseUrl",
            "optional": true,
            "type": "string",
            "description": "Instead of endpointId + requestId: the response_url queue.submit returned."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "status",
            "optional": false,
            "type": "OK | CANCELLATION_REQUESTED | ALREADY_COMPLETED | NOT_FOUND",
            "description": "OK: removed from the queue, never runs. CANCELLATION_REQUESTED: running, fal asked the runner to stop (it may still finish). ALREADY_COMPLETED or NOT_FOUND: nothing to cancel."
          }
        ]
      }
    },
