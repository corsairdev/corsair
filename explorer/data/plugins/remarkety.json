{
  "id": "remarkety",
  "displayName": "Remarkety",
  "description": "Manage stores and their sync status, create and unsubscribe contacts, build and update email campaigns with their rules and templates, and read products, rules and segments with Remarkety.",
  "npmPackageName": "@corsair-dev/remarkety",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 20,
    "webhooks": 0,
    "db": 0
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "remarkety.api.campaigns.create",
      "shortPath": "campaigns.create",
      "description": "Create a campaign from a type and its actions, each an email or an api webhook with the rules that decide when it runs",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "storeId",
            "optional": false,
            "type": "string | number",
            "description": "The store ID from Settings > API Keys (a short string such as AbC123xy), or the numeric store id."
          },
          {
            "key": "type",
            "optional": false,
            "type": "string",
            "description": "A campaign type from campaigns.types."
          },
          {
            "key": "actions",
            "optional": false,
            "type": "{ type: email | api, webhook?: string, subject?: string, baseTemplate?: string, rules: { type: string, operator: string, value: string }[] }[]",
            "description": "The action this campaign runs. This API version takes exactly one."
          },
          {
            "key": "mode",
            "optional": true,
            "type": "run | test | stop",
            "description": "run starts it, test sends a sample to testEmail, stop halts it. Defaults to Remarkety's own choice."
          },
          {
            "key": "testEmail",
            "optional": true,
            "type": "string",
            "description": "Where a test send goes, when mode is test."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": true,
            "type": "number | null"
          },
          {
            "key": "type",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "actions",
            "optional": true,
            "type": "Record<string, JsonValue>[] | null"
          },
          {
            "key": "mode",
            "optional": true,
            "type": "string | null",
            "description": "run, test or stop."
          },
          {
            "key": "testEmail",
            "optional": true,
            "type": "string | null"
          }
        ]
      }
    },
