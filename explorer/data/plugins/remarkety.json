      "path": "remarkety.api.contacts.create",
      "shortPath": "contacts.create",
      "description": "Create or update a contact in a store; Remarkety emails a double opt-in request unless doubleOptin is false",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "storeId",
            "optional": false,
            "type": "string | number",
            "description": "The store ID from Settings > API Keys (a short string such as AbC123xy), or the numeric store id."
          },
          {
            "key": "email",
            "optional": false,
            "type": "string"
          },
          {
            "key": "firstName",
            "optional": true,
            "type": "string"
          },
          {
            "key": "lastName",
            "optional": true,
            "type": "string"
          },
          {
            "key": "tags",
            "optional": true,
            "type": "string[]"
          },
          {
            "key": "properties",
            "optional": true,
            "type": "Record<string, JsonValue>",
            "description": "Custom contact properties as one object, such as { country: \"US\", city: \"Austin\", rewardsPoints: 100 }. Remarkety refuses an array."
          },
          {
            "key": "doubleOptin",
            "optional": true,
            "type": "boolean",
            "description": "Remarkety defaults this to true, which emails the contact a confirmation request before they can be marketed to. Pass false to add the contact without that email."
          },
          {
            "key": "allowedMarketing",
            "optional": true,
            "type": "boolean",
            "description": "True marks the contact as marketing-allowed."
          }
        ]
