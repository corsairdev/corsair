{
  "id": "googleslides",
  "displayName": "Google Slides",
  "description": "Presentation editor for building and sharing slide decks, with slides, text, shapes, images, tables and speaker notes.",
  "npmPackageName": "@corsair-dev/googleslides",
  "authTypes": ["oauth_2"],
  "defaultAuthType": "oauth_2",
  "counts": {
    "api": 31,
    "webhooks": 0,
    "db": 1
  },
  "auth": [
    {
      "authType": "oauth_2",
      "integrationFields": ["client_id", "client_secret", "redirect_url"],
      "accountFields": [
        "access_token",
        "refresh_token",
        "expires_at",
        "scope",
        "webhook_signature"
      ]
    }
  ],
  "api": [
    {
      "path": "googleslides.api.batch.update",
      "shortPath": "batch.update",
      "description": "Apply raw Slides batchUpdate requests atomically, for operations without a typed endpoint. Deletions are refused; use the typed operation.",
      "riskLevel": "destructive",
      "irreversible": true,
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "presentationId",
            "optional": false,
            "type": "string"
          },
          {
            "key": "requests",
            "optional": false,
            "type": "{ insertText?: {} }[]",
            "description": "Raw Slides batchUpdate requests, applied atomically. Use the typed groups where they exist."
          },
          {
            "key": "writeControl",
            "optional": true,
            "type": "{ requiredRevisionId?: string }",
            "description": "Fails the batch when the presentation moved past this revision"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "presentationId",
            "optional": false,
            "type": "string"
          },
          {
            "key": "replies",
            "optional": false,
            "type": "Record<string, {}>[]"
          },
          {
            "key": "writeControl",
            "optional": true,
            "type": "{ requiredRevisionId?: string | null } | null"
          },
          {
            "key": "commentUpdateState",
            "optional": true,
            "type": "string | null",
            "description": "Whether comment requests in the batch were saved: NO_UPDATES_REQUESTED, ALL_SAVED or ALL_FAILED_UNKNOWN_REASON"
          }
        ]
      }
    },
