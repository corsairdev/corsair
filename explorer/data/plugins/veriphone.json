      "path": "veriphone.api.verifyPhoneNumber",
      "shortPath": "verifyPhoneNumber",
      "description": "Tool to verify if a phone number is valid. Use when you need to confirm formatting, region, and carrier details.",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "phone",
            "optional": false,
            "type": "string",
            "description": "Phone number to verify. International E.164 format recommended."
          },
          {
            "key": "default_country",
            "optional": true,
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code used when the number has no international prefix."
          },
          {
            "key": "mode",
            "optional": true,
            "type": "static | current",
            "description": "static (default, 1 credit) or current (live registry lookup, 10 credits)."
          },
          {
            "key": "record",
            "optional": true,
            "type": "boolean",
            "description": "true to save the result to the account verification history."
          }
        ]
      },
      "output": {
