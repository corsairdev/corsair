          },
          {
            "key": "excludeDates",
            "optional": true,
            "type": "string[]"
          }
        ]
      }
    },
    {
      "path": "ayrshare.api.posts.delete",
      "shortPath": "posts.delete",
      "description": "Delete an Ayrshare post by id. Published Instagram and TikTok posts cannot be deleted via API; use markManualDeleted only after deleting them on the network.",
      "riskLevel": "destructive",
      "irreversible": true,
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": false,
            "type": "string",
            "description": "Ayrshare top-level Post ID"
          },
          {
            "key": "markManualDeleted",
            "optional": true,
            "type": "boolean",
            "description": "Mark deleted in Ayrshare without deleting on the network. Instagram and TikTok published posts cannot be deleted via API."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "status",
            "optional": false,
            "type": "string"
          },
          {
            "key": "id",
            "optional": true,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "ayrshare.api.posts.history",
      "shortPath": "posts.history",
      "description": "Fetch Ayrshare post history, filterable by date, status, network, and record count.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "limit",
            "optional": true,
            "type": "number",
            "description": "Number of recent posts. Default 25, max 1000."
          },
          {
            "key": "lastDays",
            "optional": true,
            "type": "number",
            "description": "Last n days by publish date. Default 30. 0 returns the full history (up to limit). Ignored when startDate and endDate are set."
          },
          {
            "key": "startDate",
            "optional": true,
            "type": "string",
            "description": "ISO-8601 start date (inclusive)"
          },
          {
            "key": "endDate",
            "optional": true,
            "type": "string",
            "description": "ISO-8601 end date (inclusive)"
          },
          {
            "key": "status",
            "optional": true,
            "type": "success | error | processing | pending | paused | deleted | awaiting approval",
            "description": "Filter by post status. Deleted posts are only returned with status=deleted."
          },
          {
            "key": "platforms",
            "optional": true,
            "type": "string[]",
            "description": "Filter by network; OR logic. Example: facebook, instagram."
          },
          {
            "key": "type",
            "optional": true,
            "type": "immediate | scheduled",
            "description": "immediate posts vs scheduled posts"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "history",
            "optional": false,
            "type": "{ id: string, post?: string | null, platforms?: string[], postIds?: { platform?: string | null, id?: string | number | null, status?: string | null, postUrl?: string | null, isVideo?: boolean | null }[], status?: string | null, created?: string | null, scheduleDate?: string | { _seconds?: number | null, _nanoseconds?: number | null, utc?: string | null }, errors?: any[], mediaUrls?: string[], urls?: any[], type?: string | null, notes?: string | null, profileTitle?: string | null, refId?: string | null, requiresApproval?: boolean | null, approved?: boolean | null, approvedBy?: string | null, approvedDate?: string | null, rejectedBy?: string | null, rejectedDate?: string | null, shortenLinks?: boolean | null }[]"
          },
          {
            "key": "count",
            "optional": true,
            "type": "number"
          },
          {
            "key": "refId",
            "optional": true,
            "type": "string"
          },
          {
            "key": "lastUpdated",
            "optional": true,
            "type": "string"
          },
          {
            "key": "nextUpdate",
            "optional": true,
            "type": "string"
          }
        ]
      }
    }
