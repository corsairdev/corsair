    {
      "path": "ayrshare.api.autoSchedule.set",
      "shortPath": "autoSchedule.set",
      "description": "Create or replace an auto-post schedule. Its case-sensitive title is the join key used by publish autoSchedule.title.",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "schedule",
            "optional": true,
            "type": "string[]",
            "description": "UTC times; required unless setStartDate is provided"
          },
          {
            "key": "title",
            "optional": true,
            "type": "string",
            "description": "Case-sensitive schedule name and join key for publish autoSchedule.title"
          },
          {
            "key": "setStartDate",
            "optional": true,
            "type": "string",
            "description": "ISO-8601 UTC date-time to begin the schedule"
          },
          {
            "key": "daysOfWeek",
            "optional": true,
            "type": "number[]",
            "description": "Weekdays as 0-6, Sunday through Saturday"
          },
          {
            "key": "excludeDates",
            "optional": true,
            "type": "string[]",
            "description": "UTC dates excluded from future auto-scheduling"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
