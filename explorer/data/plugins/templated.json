    {
      "path": "templated.api.renders.create",
      "shortPath": "renders.create",
      "description": "Render a template to an image, PDF or video, spending an API credit; layer overrides fill the template",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "template",
            "optional": true,
            "type": "string",
            "description": "The template to render. Required unless `templates` is sent."
          },
          {
            "key": "templates",
            "optional": true,
            "type": "string[]",
            "description": "Batch render several templates. When present, `template` is ignored and not required."
          },
          {
            "key": "layers",
            "optional": true,
            "type": "Record<string, Record<string, any>>",
            "description": "Layer overrides keyed by layer name, each a map of property to value, e.g. `{ \"text-1\": { \"text\": \"Hello\" } }`."
          },
          {
            "key": "format",
            "optional": true,
            "type": "jpg | png | webp | pdf | mp4 | html",
            "description": "The output format. The API defaults it to jpg."
          },
          {
            "key": "width",
            "optional": true,
            "type": "number",
            "description": "Custom width in pixels, 100 to 5000."
          },
          {
            "key": "height",
            "optional": true,
            "type": "number",
            "description": "Custom height in pixels, 100 to 5000."
          },
          {
            "key": "scale",
            "optional": true,
            "type": "number",
            "description": "Scale factor for the final render, 0.1 to 2.0. Defaults to 1."
          },
          {
            "key": "transparent",
            "optional": true,
            "type": "boolean",
            "description": "A transparent background, for png only."
          },
          {
            "key": "duration",
            "optional": true,
            "type": "number",
            "description": "Video duration in milliseconds, for mp4, up to 90000."
          },
          {
            "key": "fps",
            "optional": true,
            "type": "number",
            "description": "Frames per second, for mp4, 1 to 60."
          },
          {
            "key": "flatten",
            "optional": true,
            "type": "boolean",
            "description": "Flatten the PDF, for print."
          },
          {
            "key": "cmyk",
            "optional": true,
            "type": "boolean",
            "description": "Use CMYK colour, for print."
          },
          {
            "key": "name",
            "optional": true,
            "type": "string",
            "description": "A name for the render."
          },
          {
            "key": "background",
            "optional": true,
            "type": "string",
            "description": "A hex background colour."
          },
          {
            "key": "external_id",
            "optional": true,
            "type": "string",
            "description": "Your own identifier for this render."
          },
          {
            "key": "async",
            "optional": true,
            "type": "boolean",
            "description": "Render asynchronously and return while it is still PENDING. Defaults to false."
          },
          {
            "key": "webhook_url",
            "optional": true,
            "type": "string",
            "description": "A URL Templated posts the finished render to."
          }
        ]
      },
      "output": {
        "kind": "inline",
        "type": "{ id: string, url?: string | null, storage_url?: string | null, width?: number | null, height?: number | null, status?: string | null, format?: string | null, templateId?: string | null, templateName?: string | null, name?: string | null, createdAt?: string | null, externalId?: string | null } | { id: string, url?: string | null, storage_url?: string | null, width?: number | null, height?: number | null, status?: string | null, format?: string | null, templateId?: string | null, templateName?: string | null, name?: string | null, createdAt?: string | null, externalId?: string | null }[]"
