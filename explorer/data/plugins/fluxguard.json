            "key": "credits",
            "optional": true,
            "type": "number | null",
            "description": "Credits remaining"
          },
          {
            "key": "siteCount",
            "optional": true,
            "type": "number | null",
            "description": "Sites being monitored"
          },
          {
            "key": "notifyGap",
            "optional": true,
            "type": "number | null",
            "description": "Minutes between change notifications"
