      "path": "imagekit.api.files.upload",
      "shortPath": "files.upload",
      "description": "Upload a file from an https URL or base64 content into the media library, optionally into a folder and with tags",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "file",
            "optional": false,
            "type": "string",
            "description": "The file to upload: an https URL ImageKit can fetch, or base64-encoded content."
          },
          {
            "key": "fileName",
            "optional": false,
            "type": "string",
            "description": "Name the file gets in the media library, e.g. photo.jpg."
          },
          {
            "key": "folder",
            "optional": true,
            "type": "string",
            "description": "Destination folder path, e.g. `/products/`."
          },
          {
            "key": "tags",
            "optional": true,
            "type": "string[]",
            "description": "Tags to attach to the uploaded file; no commas inside a tag."
          },
          {
            "key": "isPrivateFile",
            "optional": true,
            "type": "boolean",
            "description": "Mark the file private; it is then served only through a signed URL or a named transformation."
          },
          {
            "key": "isPublished",
            "optional": true,
            "type": "boolean",
            "description": "Publish the file immediately."
          },
          {
            "key": "useUniqueFileName",
            "optional": true,
            "type": "boolean",
            "description": "Add a random suffix to fileName when true (the default)."
          },
          {
            "key": "overwriteFile",
            "optional": true,
            "type": "boolean",
            "description": "Replace an existing file at the same path."
          },
          {
            "key": "overwriteTags",
            "optional": true,
            "type": "boolean",
            "description": "When overwriting a file and no tags are sent, true (the default) removes its existing tags and false keeps them. Sent tags always replace them."
          },
          {
            "key": "overwriteAITags",
            "optional": true,
            "type": "boolean",
            "description": "When overwriting a file, true (the default) removes its AI tags and false keeps them."
          },
          {
            "key": "overwriteCustomMetadata",
            "optional": true,
            "type": "boolean",
            "description": "When overwriting a file and no customMetadata is sent, true (the default) removes its existing custom metadata and false keeps it. Sent customMetadata always replaces it."
          },
          {
            "key": "customMetadata",
            "optional": true,
            "type": "Record<string, any>",
            "description": "Custom metadata to set, keyed by field label, identifier or UUID."
          },
          {
            "key": "description",
            "optional": true,
            "type": "string",
            "description": "Short human-readable description stored with the file."
          }
