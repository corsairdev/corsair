      "path": "imagekit.api.files.list",
      "shortPath": "files.list",
      "description": "List and search files and folders with paging (limit and skip), a folder path filter, file type and a searchQuery expression",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "type",
            "optional": true,
            "type": "file | file-version | folder | all",
            "description": "Asset kind to list; the default `file` lists only files."
          },
          {
            "key": "path",
            "optional": true,
            "type": "string",
            "description": "Only assets inside this folder path, e.g. `/products/`."
          },
          {
            "key": "searchQuery",
            "optional": true,
            "type": "string",
            "description": "Search filter expression over name, tags, type, size and createdAt, e.g. `name = \"summer\"`."
          },
          {
            "key": "fileType",
            "optional": true,
            "type": "all | image | non-image",
            "description": "All files, images only, or non-image files (video and others)."
          },
          {
            "key": "sort",
            "optional": true,
            "type": "ASC_NAME | DESC_NAME | ASC_CREATED | DESC_CREATED | ASC_UPDATED | DESC_UPDATED | ASC_HEIGHT | DESC_HEIGHT | ASC_WIDTH | DESC_WIDTH | ASC_SIZE | DESC_SIZE | ASC_RELEVANCE | DESC_RELEVANCE",
            "description": "Sort token, e.g. ASC_CREATED (the default) or DESC_SIZE."
          },
          {
            "key": "limit",
            "optional": true,
            "type": "number",
            "description": "Page size, 1-1000; the default is 1000."
          },
          {
            "key": "skip",
            "optional": true,
            "type": "number",
            "description": "Assets to skip before this page; combine with limit to page."
          }
        ]
      },
      "output": {
        "kind": "inline",
        "type": "({ fileId: string, type?: string | null, name?: string | null, filePath?: string | null, url?: string | null, thumbnail?: string | null, fileType?: string | null, size?: number | null, width?: number | null, height?: number | null, tags?: string[] | null, AITags?: { name: string, source?: string | null, confidence?: number | null }[] | null, versionInfo?: { id: string, name?: string | null } | null, isPrivateFile?: boolean | null, isPublished?: boolean | null, customCoordinates?: string | null, description?: string | null, customMetadata?: Record<string, any> | null, extensionStatus?: Record<string, any> | null, embeddedMetadata?: Record<string, any> | null, createdAt?: string | null, updatedAt?: string | null } | { type?: string | null, folderId: string, name?: string | null, folderPath?: string | null, customMetadata?: Record<string, any> | null, createdAt?: string | null, updatedAt?: string | null })[]"
