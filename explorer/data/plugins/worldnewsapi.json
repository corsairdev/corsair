    {
      "path": "worldnewsapi.api.news.newsWebsiteToRssFeed",
      "shortPath": "news.newsWebsiteToRssFeed",
      "description": "Convert any news website page into an RSS feed with the latest news from that page.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "url",
            "optional": false,
            "type": "string",
            "description": "The URL of the news website/page to convert into an RSS 2.0 feed."
          },
          {
            "key": "extractNews",
            "optional": true,
            "type": "boolean",
            "description": "Whether to extract full article text/data for each item in the feed (costs additional quota). Defaults to false."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "title",
            "optional": true,
            "type": "string"
          },
          {
            "key": "link",
            "optional": true,
            "type": "string"
          },
          {
            "key": "description",
            "optional": true,
            "type": "string"
          },
          {
            "key": "pubDate",
            "optional": true,
            "type": "string"
          },
          {
            "key": "lastBuildDate",
            "optional": true,
            "type": "string"
          },
          {
            "key": "language",
            "optional": true,
            "type": "string"
          },
          {
            "key": "items",
            "optional": false,
            "type": "{ title?: string, link?: string, guid?: string, pubDate?: string, description?: string, author?: string, category?: string, enclosureUrl?: string }[]"
          },
          {
            "key": "rawXml",
            "optional": true,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "worldnewsapi.api.news.searchNews",
      "shortPath": "news.searchNews",
      "description": "Search and filter news by text, date, location, category, language, and more.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "text",
            "optional": true,
            "type": "string",
            "description": "Search query text. Supports implicit AND, OR, negation with -, parentheses, and quotes for exact phrases."
          },
          {
            "key": "textMatchIndexes",
            "optional": true,
            "type": "string",
            "description": "Where to search for text: \"title\", \"content\", or \"title,content\"."
          },
          {
            "key": "sourceCountry",
            "optional": true,
            "type": "string",
            "description": "Filter by 2-letter ISO 3166 country code."
          },
          {
            "key": "language",
            "optional": true,
            "type": "string",
            "description": "Filter by 2-letter ISO 639-1 language code."
          },
          {
            "key": "minSentiment",
            "optional": true,
            "type": "number",
            "description": "Minimum sentiment score between -1.0 (very negative) and 1.0 (very positive)."
          },
          {
            "key": "maxSentiment",
            "optional": true,
            "type": "number",
            "description": "Maximum sentiment score between -1.0 and 1.0."
          },
          {
            "key": "earliestPublishDate",
            "optional": true,
            "type": "string",
            "description": "Filter for news published on or after this timestamp (YYYY-MM-DD HH:MM:SS or YYYY-MM-DD)."
          },
          {
            "key": "latestPublishDate",
            "optional": true,
            "type": "string",
            "description": "Filter for news published on or before this timestamp (YYYY-MM-DD HH:MM:SS or YYYY-MM-DD)."
          },
          {
            "key": "newsSources",
            "optional": true,
            "type": "string",
            "description": "Comma-separated list of up to 10 news sources (e.g., \"bbc.co.uk,nytimes.com\")."
          },
          {
            "key": "authors",
            "optional": true,
            "type": "string",
            "description": "Comma-separated list of author names."
          },
          {
            "key": "categories",
            "optional": true,
            "type": "string",
            "description": "Comma-separated categories (politics, sports, business, technology, entertainment, health, science, etc.)."
          },
          {
            "key": "entities",
            "optional": true,
            "type": "string",
            "description": "Filter by semantic entities (e.g., \"ORG:Tesla,PER:Elon Musk\")."
          },
          {
            "key": "locationFilter",
            "optional": true,
            "type": "string",
            "description": "Filter by geographic radius in the format \"latitude,longitude,radius in km\" (radius: 1-100)."
          },
          {
            "key": "sort",
            "optional": true,
            "type": "string",
            "description": "Sort criteria, typically \"publish-time\"."
          },
          {
            "key": "sortDirection",
            "optional": true,
            "type": "ASC | DESC",
            "description": "Sort direction: \"ASC\" or \"DESC\". Defaults to DESC for publish-time."
          },
          {
            "key": "offset",
            "optional": true,
            "type": "number",
            "description": "Number of results to skip for pagination."
          },
          {
            "key": "number",
            "optional": true,
            "type": "number",
            "description": "Number of results to return (1-100). Defaults to 10."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "offset",
            "optional": false,
            "type": "number"
          },
          {
            "key": "number",
            "optional": false,
            "type": "number"
          },
          {
            "key": "available",
            "optional": false,
            "type": "number"
          },
          {
            "key": "news",
            "optional": false,
            "type": "{ id: number, title: string, text?: string, summary?: string | null, url: string, image?: string | null, video?: string | null, publish_date?: string, author?: string | null, authors?: string | null[], category?: string, language?: string, source_country?: string, sentiment?: number }[]"
          }
        ]
      }
    },
    {
      "path": "worldnewsapi.api.news.searchNewsSources",
      "shortPath": "news.searchNewsSources",
      "description": "Search whether a news source is being monitored by the World News API.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "name",
            "optional": false,
            "type": "string",
            "description": "The (partial) name of the news source to search for (e.g. \"bbc\", \"reuters\", \"times\")."
