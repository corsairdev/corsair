  "api": [
    {
      "path": "worldnewsapi.api.news.extractNews",
      "shortPath": "news.extractNews",
      "description": "Extract a news article from a website to a well-structured JSON object, including title, text, images, videos, publish date, authors, language, and sentiment.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "url",
            "optional": false,
            "type": "string",
            "description": "The URL of the news article to extract into structured data."
          },
          {
            "key": "analyze",
            "optional": true,
            "type": "boolean",
            "description": "Whether to analyze the extracted news (extract named entities, detect sentiment, etc.). Defaults to false."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "title",
            "optional": true,
            "type": "string"
          },
          {
            "key": "text",
            "optional": true,
            "type": "string"
          },
          {
            "key": "url",
            "optional": true,
            "type": "string"
          },
          {
            "key": "image",
            "optional": true,
            "type": "string"
          },
          {
            "key": "images",
            "optional": true,
            "type": "{ title?: string, url: string, width?: number, height?: number }[]"
          },
          {
            "key": "video",
            "optional": true,
            "type": "string"
          },
          {
            "key": "videos",
            "optional": true,
            "type": "{ title?: string, url: string, summary?: string, duration?: number, thumbnail?: string }[]"
          },
          {
            "key": "publish_date",
            "optional": true,
            "type": "string"
          },
          {
            "key": "author",
            "optional": true,
            "type": "string"
          },
          {
            "key": "authors",
            "optional": true,
            "type": "string | null[]"
          },
          {
            "key": "language",
            "optional": true,
            "type": "string"
          },
          {
            "key": "source_country",
            "optional": true,
            "type": "string"
          },
          {
            "key": "sentiment",
            "optional": true,
            "type": "number"
          },
          {
            "key": "entities",
            "optional": true,
            "type": "{ name: string, type: string, sentiment?: number }[]"
          }
        ]
      }
    },
    {
      "path": "worldnewsapi.api.news.extractNewsLinks",
      "shortPath": "news.extractNewsLinks",
      "description": "Extract news article links from a website or webpage, with optional filtering by URL prefix and subdomain inclusion.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "url",
            "optional": false,
            "type": "string",
            "description": "The webpage or site URL from which news article links should be extracted."
          },
          {
            "key": "analyze",
            "optional": true,
            "type": "boolean",
            "description": "Whether to analyze extracted links. Defaults to false."
          },
          {
            "key": "prefix",
            "optional": true,
            "type": "string",
            "description": "The prefix that discovered news links must start with."
          },
          {
            "key": "subDomain",
            "optional": true,
            "type": "boolean",
            "description": "Whether to include links to news articles on sub-domains. Defaults to true."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "status",
            "optional": true,
            "type": "string"
          },
          {
            "key": "news_links",
            "optional": false,
            "type": "string[]"
          }
        ]
      }
    },
    {
