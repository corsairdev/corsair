          }
        ]
      }
    },
    {
      "path": "worldnewsapi.api.news.topNews",
      "shortPath": "news.topNews",
      "description": "Get the top news from a country in a specific language for a given date. The top news are clustered from multiple sources in the specified country.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "sourceCountry",
            "optional": false,
            "type": "string",
            "description": "The 2-letter ISO 3166 country code for which top news should be retrieved (e.g., \"us\", \"in\", \"gb\")."
          },
          {
            "key": "language",
            "optional": false,
            "type": "string",
            "description": "The 2-letter ISO 639-1 language code of the top news (e.g., \"en\", \"es\", \"fr\")."
          },
          {
            "key": "date",
            "optional": true,
            "type": "string",
            "description": "The date for which the top news should be retrieved (YYYY-MM-DD). Defaults to today."
          },
          {
            "key": "headlinesOnly",
            "optional": true,
            "type": "boolean",
            "description": "Whether to only return basic headline fields (id, title, url). Defaults to false."
          },
          {
            "key": "maxNewsPerCluster",
            "optional": true,
            "type": "number",
            "description": "How many news articles to return per story cluster. Default is 1."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "top_news",
            "optional": false,
            "type": "{ news: { id: number, title: string, text?: string, summary?: string | null, url: string, image?: string | null, video?: string | null, publish_date?: string, author?: string | null, authors?: string | null[], category?: string, language?: string, source_country?: string, sentiment?: number }[] }[]"
          },
          {
            "key": "language",
            "optional": true,
            "type": "string"
          },
          {
            "key": "country",
            "optional": true,
            "type": "string"
          }
        ]
      }
    }
  ],
