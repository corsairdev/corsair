{
  "id": "tinypng",
  "displayName": "TinyPNG",
  "description": "Image compression API for shrinking, resizing, and converting AVIF, WebP, JPEG, and PNG images.",
  "npmPackageName": "@corsair-dev/tinypng",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 5,
    "webhooks": 0,
    "db": 3
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "tinypng.api.account.getCompressionCount",
      "shortPath": "account.getCompressionCount",
      "description": "Get the number of compressions made this calendar month",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": []
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "compressionCount",
            "optional": false,
            "type": "number"
          }
        ]
      }
    },
    {
      "path": "tinypng.api.images.compressAndStoreInAzure",
      "shortPath": "images.compressAndStoreInAzure",
      "description": "Compress an image and upload the result to Azure Blob Storage through a SAS URL",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "source",
            "optional": false,
            "type": "{ url: string } | { base64: string }"
          },
          {
            "key": "blobUrl",
            "optional": false,
            "type": "string",
            "description": "Full blob URL with a SAS token granting create/write, e.g. https://acct.blob.core.windows.net/container/name.png?sv=..."
          },
          {
            "key": "cacheControl",
            "optional": true,
            "type": "string"
          },
          {
            "key": "resize",
            "optional": true,
            "type": "{ method: scale | fit | cover | thumb, width?: number, height?: number }"
          },
          {
            "key": "convert",
            "optional": true,
            "type": "{ type: image/avif | image/webp | image/jpeg | image/png | image/jxl | */* | image/avif | image/webp | image/jpeg | image/png | image/jxl | */*[] }",
            "description": "Several types return the smallest result"
          },
          {
            "key": "transform",
            "optional": true,
            "type": "{ background: string }"
          },
          {
            "key": "preserve",
            "optional": true,
            "type": "copyright | creation | location[]"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "imageId",
            "optional": false,
            "type": "string"
          },
          {
            "key": "blobUrl",
            "optional": false,
            "type": "string",
            "description": "Blob URL without the SAS query string"
          },
          {
            "key": "contentType",
            "optional": false,
            "type": "string"
          },
          {
            "key": "size",
            "optional": false,
            "type": "number"
          },
          {
            "key": "width",
            "optional": true,
            "type": "number"
          },
          {
            "key": "height",
            "optional": true,
            "type": "number"
          },
          {
            "key": "compressionCount",
            "optional": true,
            "type": "number"
          },
          {
            "key": "etag",
            "optional": true,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "tinypng.api.images.output",
      "shortPath": "images.output",
      "description": "Download a compressed image by its Tinify image ID as base64",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "imageId",
            "optional": false,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "imageId",
            "optional": false,
            "type": "string"
          },
          {
            "key": "contentType",
            "optional": false,
            "type": "string"
          },
          {
            "key": "size",
            "optional": false,
            "type": "number"
          },
          {
            "key": "width",
            "optional": true,
            "type": "number"
          },
          {
            "key": "height",
            "optional": true,
            "type": "number"
          },
          {
            "key": "compressionCount",
            "optional": true,
            "type": "number"
          },
          {
            "key": "base64",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "tinypng.api.images.shrink",
      "shortPath": "images.shrink",
      "description": "Compress an image from a URL or base64 bytes and return its Tinify image ID (uses one compression)",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "source",
            "optional": false,
            "type": "{ url: string } | { base64: string }"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "imageId",
            "optional": false,
            "type": "string"
          },
          {
            "key": "outputUrl",
            "optional": false,
            "type": "string"
          },
          {
            "key": "compressionCount",
            "optional": true,
            "type": "number"
          },
          {
            "key": "input",
            "optional": false,
            "type": "{ size: number, type: string }"
          },
          {
            "key": "output",
            "optional": true,
            "type": "{ size: number, type: string, width?: number, height?: number, ratio?: number }"
          }
        ]
      }
    },
    {
      "path": "tinypng.api.images.transform",
      "shortPath": "images.transform",
      "description": "Resize, convert, fill the background of, or preserve metadata on a compressed image, optionally storing it on S3 or GCS",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "imageId",
            "optional": false,
            "type": "string"
          },
          {
            "key": "resize",
            "optional": true,
            "type": "{ method: scale | fit | cover | thumb, width?: number, height?: number }"
          },
          {
            "key": "convert",
            "optional": true,
            "type": "{ type: image/avif | image/webp | image/jpeg | image/png | image/jxl | */* | image/avif | image/webp | image/jpeg | image/png | image/jxl | */*[] }",
            "description": "Several types return the smallest result"
          },
          {
            "key": "transform",
            "optional": true,
            "type": "{ background: string }"
          },
          {
            "key": "preserve",
            "optional": true,
            "type": "copyright | creation | location[]"
          },
          {
            "key": "store",
            "optional": true,
            "type": "{ service: s3, aws_access_key_id: string, aws_secret_access_key: string, region: string, path: string, headers?: { Cache-Control: string }, acl?: string } | { service: gcs, gcp_access_token: string, path: string, headers?: { Cache-Control: string } }",
            "description": "Upload the result to S3 or GCS instead of returning the bytes"
          }
        ]
      },
      "output": {
        "kind": "inline",
        "type": "{ imageId: string, contentType: string, size: number, width?: number, height?: number, compressionCount?: number, base64: string, stored: false } | { stored: true, imageId: string, location: string, width?: number, height?: number, compressionCount?: number }"
      }
    }
  ],
  "webhooks": [],
