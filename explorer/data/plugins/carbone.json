    {
      "path": "carbone.api.templates.delete",
      "shortPath": "templates.delete",
      "description": "Permanently delete a template from the Carbone server by its 64-character hexadecimal template ID. This action is irreversible. Ensure you have the correct template ID before deleting.",
      "riskLevel": "destructive",
      "irreversible": true,
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "templateId",
            "optional": false,
            "type": "string",
            "description": "64-character hexadecimal template ID to permanently delete"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "success",
            "optional": false,
            "type": "boolean",
            "description": "Indicates if template was successfully deleted"
          },
          {
            "key": "message",
            "optional": true,
            "type": "string",
            "description": "Confirmation message from Carbone server"
          }
        ]
      }
    },
    {
