    {
      "path": "carbone.api.templates.list",
      "shortPath": "templates.list",
      "description": "Tool to retrieve a list of templates from Carbone storage with filtering, search, and cursor-based pagination. Use when you need to find templates, search by name or ID, or iterate through all deployed templates.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": true,
            "type": "string",
            "description": "Filter templates by exact template ID match"
          },
          {
            "key": "templateId",
            "optional": true,
            "type": "string",
            "description": "Alias for id; filter templates by exact template ID match"
          },
          {
            "key": "versionId",
            "optional": true,
            "type": "string",
            "description": "Filter templates by exact version ID match"
          },
          {
            "key": "category",
            "optional": true,
            "type": "string",
            "description": "Filter templates belonging to a specific category folder"
          },
          {
            "key": "search",
            "optional": true,
            "type": "string",
            "description": "Search templates by name or identifier query"
          },
          {
            "key": "cursor",
            "optional": true,
            "type": "string | number",
            "description": "Pagination cursor for iterating through templates"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "success",
            "optional": false,
            "type": "boolean",
            "description": "Indicates if listing templates succeeded"
          },
          {
            "key": "data",
            "optional": false,
            "type": "{ versionId?: string, id?: string | null, name?: string, category?: string, type?: string, size?: number, comment?: string, tags?: string[], deployedAt?: number | null, createdAt?: number, expireAt?: number | null, origin?: number }[]",
            "description": "Array of deployed Carbone template metadata records"
          },
          {
            "key": "hasMore",
            "optional": true,
            "type": "boolean",
            "description": "Whether more template records are available on next page"
          },
          {
            "key": "nextCursor",
            "optional": true,
            "type": "string | number",
            "description": "Cursor to retrieve the next page of templates"
          }
        ]
      }
    },
