          },
          {
            "key": "data",
            "optional": true,
            "type": "{} | lazy[]",
            "description": "JSON dataset to merge into the template placeholders"
          },
          {
            "key": "convertTo",
            "optional": true,
            "type": "string | { formatName: string, formatOptions?: {} }",
            "description": "Target output document format extension (e.g. pdf, docx, xlsx, html)"
          },
          {
            "key": "converter",
            "optional": true,
            "type": "string",
            "description": "Converter engine to use for document conversion"
          },
          {
            "key": "lang",
            "optional": true,
            "type": "string",
            "description": "Localization language code for formatting numbers and dates"
          },
          {
            "key": "timezone",
            "optional": true,
            "type": "string",
            "description": "IANA timezone string for date operations"
          },
          {
            "key": "currency",
            "optional": true,
            "type": "string",
            "description": "ISO 4217 currency code for currency formatting"
          },
          {
            "key": "translations",
            "optional": true,
            "type": "{}",
            "description": "Translation dictionaries for multi-language templates"
          },
          {
            "key": "enum",
            "optional": true,
            "type": "{}",
            "description": "Enum dictionaries for code translation"
          },
          {
            "key": "variable",
            "optional": true,
            "type": "{}",
            "description": "Pre-calculated variables accessible in template"
          },
          {
            "key": "complement",
            "optional": true,
            "type": "{}",
            "description": "Complementary data accessible with c. prefix"
          },
          {
            "key": "hardRefresh",
            "optional": true,
            "type": "boolean",
            "description": "Force complete recalculation of document fields"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "success",
