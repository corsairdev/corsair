          {
            "key": "content",
            "optional": false,
            "type": "string",
            "description": "Base64-encoded binary content of the retrieved template file"
          },
          {
            "key": "success",
            "optional": false,
            "type": "boolean",
            "description": "Indicates if template download was successful"
          }
        ]
