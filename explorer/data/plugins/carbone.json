  "api": [
    {
      "path": "carbone.api.render.generateReport",
      "shortPath": "render.generateReport",
      "description": "Tool to generate a Carbone report from a template and JSON data. Use when you need to render documents in various formats.",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "templateId",
            "optional": false,
            "type": "string",
            "description": "64-character hexadecimal template ID or version ID to render"
          },
          {
            "key": "data",
            "optional": true,
            "type": "{} | lazy[]",
            "description": "JSON dataset to merge into the document template placeholders"
          },
          {
            "key": "convertTo",
            "optional": true,
            "type": "string | { formatName: string, formatOptions?: {} }",
            "description": "Target file format extension to convert output document into (e.g. pdf, docx, xlsx, html)"
          },
          {
            "key": "converter",
            "optional": true,
            "type": "string",
            "description": "Converter engine to use for document conversion"
          },
          {
            "key": "lang",
            "optional": true,
            "type": "string",
            "description": "Localization language code for formatting numbers, dates, and currency (e.g. en-US, fr-FR)"
          },
          {
            "key": "timezone",
            "optional": true,
            "type": "string",
            "description": "IANA timezone string for date/time calculations (e.g. Europe/Paris, America/New_York)"
          },
          {
            "key": "currency",
            "optional": true,
            "type": "string",
            "description": "ISO 4217 currency code for currency formatters (e.g. USD, EUR)"
          },
          {
            "key": "translations",
            "optional": true,
            "type": "{}",
            "description": "Dictionary of translation strings per locale"
          },
          {
            "key": "enum",
            "optional": true,
            "type": "{}",
            "description": "Enum mapping dictionaries for translating code values"
          },
          {
            "key": "variable",
            "optional": true,
            "type": "{}",
            "description": "Pre-calculated variables accessible globally within the template"
          },
          {
            "key": "complement",
            "optional": true,
            "type": "{}",
            "description": "Complementary dataset accessible with the c. prefix in templates"
          },
          {
            "key": "hardRefresh",
            "optional": true,
            "type": "boolean",
            "description": "When true, recalculates all template functions and forces fresh render"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "success",
            "optional": false,
            "type": "boolean",
            "description": "Indicates if report generation succeeded"
          },
          {
            "key": "data",
            "optional": false,
            "type": "{ renderId: string }",
            "description": "Render result payload containing the render ID"
          }
        ]
      }
    },
    {
      "path": "carbone.api.render.renderDirect",
      "shortPath": "render.renderDirect",
      "description": "Tool to generate a document by uploading a base64-encoded template and data in a single API call. Use when you need to render documents without uploading templates separately.",
