      "path": "pointagram.api.scoreSeries.addPoints",
      "shortPath": "scoreSeries.addPoints",
      "description": "Score points for a player in a score series, optionally with a comment, tags and a transaction reference that makes a repeat call replace the earlier one",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "player_id",
            "optional": true,
            "type": "string | number"
          },
          {
            "key": "player_name",
            "optional": true,
            "type": "string"
          },
          {
            "key": "player_email",
            "optional": true,
            "type": "string"
          },
          {
            "key": "player_external_id",
            "optional": true,
            "type": "string"
          },
          {
            "key": "scoreseries_id",
            "optional": true,
            "type": "string | number"
          },
          {
            "key": "scoreseries_name",
            "optional": true,
            "type": "string"
          },
          {
            "key": "points",
            "optional": true,
            "type": "number",
            "description": "How many points to add. Supply this or pointtype_name."
          },
          {
            "key": "pointtype_name",
            "optional": true,
            "type": "string",
            "description": "A point type scores a fixed number of points; the score series must define it."
          },
          {
            "key": "source_score_id",
            "optional": true,
            "type": "string",
            "description": "Your transaction reference. Sending it again revokes the earlier transaction and adds a new one, so a retried call does not double-score."
          },
          {
            "key": "comment",
            "optional": true,
            "type": "string",
            "description": "Shown with the point in the news feed."
          },
          {
            "key": "score_time",
            "optional": true,
            "type": "string",
            "description": "When the points were scored, if not now. Sent unchanged, so include the offset."
          },
          {
            "key": "tags",
            "optional": true,
            "type": "{ name: string }[]",
            "description": "Tags to display with the scored point."
