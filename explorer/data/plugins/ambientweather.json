    }
  ],
  "api": [
    {
      "path": "ambientweather.api.devices.getData",
      "shortPath": "devices.getData",
      "description": "Fetch historical weather data for a specific Ambient Weather device",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "macAddress",
            "optional": false,
            "type": "string"
          },
          {
            "key": "limit",
            "optional": true,
            "type": "number"
          },
          {
            "key": "endDate",
            "optional": true,
            "type": "number"
          }
        ]
      },
      "output": {
        "kind": "inline",
        "type": "{ dateutc: number, date?: string, tz?: string, winddir?: number, windspeedmph?: number, windgustmph?: number, maxdailygust?: number, windgustdir?: number, winddir_avg2m?: number, windspdmph_avg2m?: number, winddir_avg10m?: number, windspdmph_avg10m?: number, tempf?: number, humidity?: number, baromrelin?: number, baromabsin?: number, tempinf?: number, humidityin?: number, hourlyrainin?: number, dailyrainin?: number, weeklyrainin?: number, monthlyrainin?: number, yearlyrainin?: number, eventrainin?: number, totalrainin?: number, uv?: number, solarradiation?: number, feelsLike?: number, dewPoint?: number, lastRain?: string }[]"
      }
    },
    {
      "path": "ambientweather.api.devices.list",
      "shortPath": "devices.list",
      "description": "List all Ambient Weather devices for the connected account with their latest readings",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": []
      },
      "output": {
        "kind": "inline",
        "type": "{ macAddress: string, info: { name: string, location?: string }, lastData: { dateutc: number, date?: string, tz?: string, winddir?: number, windspeedmph?: number, windgustmph?: number, maxdailygust?: number, windgustdir?: number, winddir_avg2m?: number, windspdmph_avg2m?: number, winddir_avg10m?: number, windspdmph_avg10m?: number, tempf?: number, humidity?: number, baromrelin?: number, baromabsin?: number, tempinf?: number, humidityin?: number, hourlyrainin?: number, dailyrainin?: number, weeklyrainin?: number, monthlyrainin?: number, yearlyrainin?: number, eventrainin?: number, totalrainin?: number, uv?: number, solarradiation?: number, feelsLike?: number, dewPoint?: number, lastRain?: string } }[]"
