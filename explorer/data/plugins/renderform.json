{
  "id": "renderform",
  "displayName": "Renderform",
  "description": "Render templates to images, PDFs and video, manage templates and their html-editor content, capture screenshots and PDFs, and read usage and fonts with Renderform.",
  "npmPackageName": "@corsair-dev/renderform",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 15,
    "webhooks": 0,
    "db": 0
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "renderform.api.fonts",
      "shortPath": "fonts",
      "description": "List the fonts available to a template, with their variants and whether each is Google or custom",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": []
      },
      "output": {
        "kind": "inline",
        "type": "{ originalName?: string | null, family?: string | null, variants?: string[] | null, defaultVariant?: string | null, subsets?: string[] | null, category?: string | null, source?: string | null, size?: number | null, createdAt?: string | null }[]"
      }
    },
    {
      "path": "renderform.api.pdf",
      "shortPath": "pdf",
      "description": "Capture a URL as a PDF in a chosen page format, optionally self-deleting after a set time; costs a credit",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "url",
            "optional": false,
            "type": "string",
            "description": "The page to capture."
          },
          {
            "key": "format",
            "optional": true,
            "type": "A5 | A4 | A3 | LETTER | LEGAL",
            "description": "Defaults to A4."
          },
          {
            "key": "expires",
            "optional": true,
            "type": "number",
            "description": "Delete the PDF after this many seconds, at most 604800 (7 days)."
          },
          {
            "key": "waitTime",
            "optional": true,
            "type": "number"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "requestId",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "href",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "request",
            "optional": true,
            "type": "Record<string, JsonValue> | null"
          }
        ]
      }
    },
    {
      "path": "renderform.api.render",
      "shortPath": "render",
      "description": "Render a template to an image, PDF or video, merging your data into its fields; costs a credit unless the answer is served from the cache, and a video render is asynchronous",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "template",
            "optional": false,
            "type": "string",
            "description": "The template identifier, such as template_1234."
          },
          {
            "key": "data",
            "optional": true,
            "type": "Record<string, JsonValue>",
            "description": "Values keyed by the template's merge fields, such as {\"my-text.text\": \"John\"}. A component's own defaults fill anything omitted."
          },
          {
            "key": "fileName",
            "optional": true,
            "type": "string",
            "description": "The output file name, without an extension."
          },
          {
            "key": "webhookUrl",
            "optional": true,
            "type": "string",
            "description": "Called when the render finishes, which suits a video render."
          },
          {
            "key": "version",
            "optional": true,
            "type": "string",
            "description": "The cache key. The same version with the same data returns the cached file and costs no credits."
          },
          {
            "key": "metadata",
            "optional": true,
            "type": "Record<string, JsonValue>",
            "description": "Extra data passed through to the webhook."
          },
          {
            "key": "batchName",
            "optional": true,
            "type": "string",
            "description": "Groups renders together, and can be filtered on in results.list."
          },
          {
            "key": "cache",
            "optional": true,
            "type": "boolean",
            "description": "Defaults to true. False forces a fresh render and skips the cache, which costs credits."
          },
          {
            "key": "width",
            "optional": true,
            "type": "number",
            "description": "Output width in pixels. Renderform crops the image to it from the top left corner."
          },
          {
            "key": "height",
            "optional": true,
            "type": "number",
            "description": "Output height in pixels. Renderform crops the image to it from the top left corner."
          },
          {
            "key": "waitTime",
            "optional": true,
            "type": "number",
            "description": "Milliseconds to wait before rendering. At most 5000."
          },
          {
            "key": "outputFormat",
            "optional": true,
            "type": "jpeg | png | webp | pdf | mp4 | webm",
            "description": "Overrides the template's format. A video format needs a template made in the Advanced Editor and always renders asynchronously."
          },
          {
            "key": "duration",
            "optional": true,
            "type": "number",
            "description": "Video renders only: length in milliseconds. Every started second costs 5 credits."
          },
          {
            "key": "fps",
            "optional": true,
            "type": "24 | 25 | 30",
            "description": "Video renders only, and sent as a string: 24, 25 or 30."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "requestId",
            "optional": true,
            "type": "string | null",
            "description": "Identifies the render, and is what results.get takes."
          },
          {
            "key": "href",
            "optional": true,
            "type": "string | null",
            "description": "The rendered file. Not usable yet when status is pending."
          },
          {
            "key": "status",
            "optional": true,
            "type": "string | null",
            "description": "pending, done or failed. Present only for an asynchronous video render."
          },
          {
            "key": "cached",
            "optional": true,
            "type": "boolean | null",
            "description": "True when the file came from the cache, which costs no credits."
          }
        ]
      }
    },
