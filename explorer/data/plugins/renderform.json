      }
    },
    {
      "path": "renderform.api.results.get",
      "shortPath": "results.get",
      "description": "Read one render result; this is how an asynchronous video render is polled until it is done or failed",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "identifier",
            "optional": false,
            "type": "string",
            "description": "The requestId a render answered with."
          }
