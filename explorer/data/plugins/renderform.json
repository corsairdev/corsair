      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "identifier",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "href",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "status",
            "optional": true,
            "type": "string | null",
            "description": "pending, done or failed."
          },
          {
            "key": "type",
            "optional": true,
            "type": "string | null",
            "description": "image, video, screenshot or preview."
          },
          {
            "key": "thumbnailHref",
            "optional": true,
            "type": "string | null",
            "description": "A video's JPEG poster frame, null otherwise."
          }
        ]
      }
    },
