{
  "id": "mocean",
  "displayName": "Mocean",
  "description": "Messaging with Mocean - SMS and delivery status, verify codes over SMS and Telegram, voice calls, WhatsApp messages and templates, number lookup, and account balance and pricing.",
  "npmPackageName": "@corsair-dev/mocean",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 20,
    "webhooks": 0,
    "db": 0
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "mocean.api.account.balance",
      "shortPath": "account.balance",
      "description": "Read the account credit balance",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": []
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "status",
            "optional": false,
            "type": "number | string"
          },
          {
            "key": "value",
            "optional": false,
            "type": "number"
          }
        ]
      }
    },
    {
      "path": "mocean.api.account.pricing",
      "shortPath": "account.pricing",
      "description": "List per-destination prices for SMS, number lookup or verify, optionally for one MCC/MNC pair",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "mocean_mcc",
            "optional": true,
            "type": "string",
            "description": "Only pricing for this Mobile Country Code; needs mocean_mnc."
          },
          {
            "key": "mocean_mnc",
            "optional": true,
            "type": "string",
            "description": "One Mobile Network Code; sent together with mocean_mcc."
          },
          {
            "key": "mocean_type",
            "optional": true,
            "type": "sms | number-lookup | verify",
            "description": "Defaults to 'sms'."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "status",
            "optional": true,
            "type": "number | string | null"
          },
          {
            "key": "destinations",
            "optional": false,
            "type": "{ country?: string | null, operator?: string | null, mcc?: string | null, mnc?: string | null, price?: number | string | null, currency?: string | null }[]"
          }
        ]
      }
    },
    {
      "path": "mocean.api.lookup.request",
      "shortPath": "lookup.request",
      "description": "Look up a number's original and current carrier and porting status, paid from prepaid credit; synchronous without a callback URL",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "mocean_to",
            "optional": false,
            "type": "string",
            "description": "The phone number to look up, with country code."
          },
          {
            "key": "mocean_nl_url",
            "optional": true,
            "type": "string",
            "description": "Callback URL for the async result. Omit it to get the full result synchronously."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "status",
            "optional": false,
            "type": "number | string"
          },
          {
            "key": "msgid",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "to",
            "optional": true,
            "type": "string | null"
          },
          {
            "key": "current_carrier",
            "optional": true,
            "type": "{ country?: string | null, name?: string | null, network_code?: string | number | null, mcc?: string | null, mnc?: string | null } | null"
          },
          {
            "key": "original_carrier",
            "optional": true,
            "type": "{ country?: string | null, name?: string | null, network_code?: string | number | null, mcc?: string | null, mnc?: string | null } | null"
          },
          {
            "key": "ported",
            "optional": true,
            "type": "string | null"
          }
        ]
      }
    },
    {
      "path": "mocean.api.sms.reportConversion",
      "shortPath": "sms.reportConversion",
      "description": "Tell Mocean whether a sent SMS reached the user (conversion tracking for OTP routes)",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "mocean_msgid",
            "optional": false,
            "type": "string",
            "description": "The msgid from the send response."
          },
          {
            "key": "mocean_delivered",
            "optional": false,
            "type": "boolean",
            "description": "true when the user received the message (for example, used the OTP)."
          },
          {
            "key": "mocean_timestamp",
            "optional": true,
            "type": "string",
            "description": "When it happened; defaults to the submission time."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "status",
            "optional": false,
            "type": "number | string"
          },
          {
            "key": "err_msg",
            "optional": true,
            "type": "string | null"
          }
        ]
      }
    },
    {
      "path": "mocean.api.sms.send",
      "shortPath": "sms.send",
      "description": "Send an SMS to up to 500 receivers, charged per destination; the response has a status and msgid per receiver",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "mocean_from",
            "optional": false,
            "type": "string",
            "description": "The Sender ID shown on the recipient handset."
          },
          {
            "key": "mocean_to",
            "optional": false,
            "type": "string",
            "description": "Receiver phone numbers with country code, separated by commas or spaces, up to 500."
          },
          {
            "key": "mocean_text",
            "optional": false,
            "type": "string",
            "description": "The message content; every receiver gets the same text."
          },
          {
            "key": "mocean_udh",
            "optional": true,
            "type": "string",
            "description": "User Data Header, e.g. 0605040B8423F0."
          },
          {
            "key": "mocean_coding",
            "optional": true,
            "type": "number",
            "description": "DCS coding scheme: 1 for 7-bit, 2 for 8-bit, 3 for UCS2."
          },
          {
            "key": "mocean_dlr_mask",
            "optional": true,
            "type": "number",
            "description": "Set to 1 to request delivery reports. Defaults to 0."
          },
          {
            "key": "mocean_dlr_url",
            "optional": true,
            "type": "string",
            "description": "Required when mocean_dlr_mask is 1: the delivery report callback URL."
          },
          {
            "key": "mocean_schedule",
            "optional": true,
            "type": "string",
            "description": "Send later, in Malaysia time (GMT+8). A wrong format is rejected by the gateway."
          },
          {
            "key": "mocean_mclass",
            "optional": true,
            "type": "number",
            "description": "Set to 1 with mocean_alt_dcs to send a Flash SMS."
          },
          {
            "key": "mocean_alt_dcs",
            "optional": true,
            "type": "number",
            "description": "Set to 1 with mocean_mclass to send a Flash SMS."
          },
          {
            "key": "mocean_charset",
            "optional": true,
            "type": "ISO-8859-1 | ISO-8859-7 | UTF-8 | Windows-1252",
            "description": "The character set used in mocean_text."
          },
          {
            "key": "mocean_validity",
            "optional": true,
            "type": "number",
            "description": "How long the message stays deliverable, in seconds."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "messages",
            "optional": false,
            "type": "{ status: number | string, receiver?: string | null, msgid?: string | null, err_msg?: string | null }[]"
          }
        ]
      }
    },
    {
      "path": "mocean.api.sms.status",
      "shortPath": "sms.status",
      "description": "Read a sent message's final status (success, failed, expired, pending or not found) and the credit it took",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
