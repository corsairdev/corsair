      "riskLevel": "destructive",
      "irreversible": true,
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "domain",
            "optional": false,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "status",
            "optional": true,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "unione.api.domain.manage",
      "shortPath": "domain.manage",
      "description": "Tool to inspect and verify sender domains: fetch DNS records, trigger a verification or DKIM check, or list domains. Deleting a domain is a separate tool.",
