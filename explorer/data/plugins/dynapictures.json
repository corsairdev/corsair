          },
          {
            "key": "fileUrl",
            "optional": false,
            "type": "string",
            "description": "Public URL of the image uploaded as the official file field."
          },
          {
            "key": "filename",
            "optional": true,
            "type": "string",
            "description": "Filename of uploaded image."
          }
