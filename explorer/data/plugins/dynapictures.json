      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": false,
            "type": "string",
            "description": "The ID of an asset."
          },
          {
            "key": "folder",
            "optional": false,
            "type": "boolean",
            "description": "Whether this asset is a folder instead of an image."
          },
          {
            "key": "mimeType",
            "optional": false,
            "type": "string",
            "description": "MIME type of an image."
