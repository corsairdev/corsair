{
  "id": "parsera",
  "displayName": "Parsera",
  "description": "Parsera is an AI web scraper you drive with plain instructions. This plugin extracts structured data from pages or raw content, manages reusable extractor and agentic scrapers, runs them synchronously or as pollable async jobs, and tracks run progress and credits.",
  "npmPackageName": "@corsair-dev/parsera",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 15,
    "webhooks": 0,
    "db": 0
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "parsera.api.agent.createScraper",
      "shortPath": "agent.createScraper",
      "description": "Create an empty agentic scraper",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": []
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "template_id",
            "optional": false,
            "type": "string",
            "description": "Scraper id (the API spells it template_id)"
          }
        ]
      }
    },
    {
      "path": "parsera.api.agent.deleteScraper",
      "shortPath": "agent.deleteScraper",
      "description": "Delete an agentic scraper",
      "riskLevel": "destructive",
      "irreversible": true,
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "scraperId",
            "optional": false,
            "type": "string",
            "description": "Scraper id"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "message",
            "optional": false,
            "type": "string",
            "description": "The API confirmation, e.g. \"Scraper deleted successfully.\""
          }
        ]
      }
    },
    {
      "path": "parsera.api.agent.extract",
      "shortPath": "agent.extract",
      "description": "Start a one-shot agentic extraction; answers a task_id to poll, stop or wait on",
      "riskLevel": "read",
      "job": {
        "idPath": "task_id",
        "status": {
          "op": "agent.getTask",
          "idArg": "taskId",
          "statusPath": "status",
          "done": ["completed"],
          "failed": ["failed", "stopped"]
        },
        "cancel": {
          "op": "agent.stopTask",
          "idArg": "taskId"
        }
      },
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "prompt",
            "optional": false,
            "type": "string",
            "description": "Prompt describing what to extract"
          },
          {
            "key": "attributes",
            "optional": true,
            "type": "{ name: string, description: string }[]",
            "description": "Attribute list describing the output fields"
          },
          {
            "key": "url",
            "optional": false,
            "type": "string",
            "description": "URL for the agent to start from"
          },
          {
            "key": "callback_url",
            "optional": true,
            "type": "string",
            "description": "URL to POST results to when extraction completes"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "task_id",
            "optional": false,
            "type": "string",
            "description": "Extraction task id"
          },
          {
            "key": "status",
            "optional": false,
            "type": "pending | running | completed | failed | stopped | string",
            "description": "Task status"
          },
          {
            "key": "error",
            "optional": true,
            "type": "string | null",
            "description": "Why a failed task failed (URL credentials redacted)"
          },
          {
            "key": "data",
            "optional": true,
            "type": "Record<string, any>[] | null",
            "description": "The extracted records once the task completed"
          }
        ]
      }
    },
    {
      "path": "parsera.api.agent.generateScraper",
      "shortPath": "agent.generateScraper",
      "description": "Build or regenerate an agentic scraper from a page and an instruction",
      "riskLevel": "destructive",
      "job": {
        "idPath": "template_id",
        "status": {
          "op": "agent.getScraper",
          "idArg": "scraperId",
          "statusPath": "status",
          "done": ["ready"],
          "failed": ["failed"]
        }
      },
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "prompt",
            "optional": false,
            "type": "string",
            "description": "Prompt describing what to extract"
          },
          {
            "key": "attributes",
            "optional": true,
            "type": "{ name: string, description: string }[]",
            "description": "Attribute list describing the output fields"
          },
          {
            "key": "url",
            "optional": false,
            "type": "string",
            "description": "URL for the agent to build on"
          },
          {
            "key": "template_id",
            "optional": true,
            "type": "string",
            "description": "Existing scraper id to regenerate; a new scraper is created when omitted"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "template_id",
            "optional": false,
            "type": "string",
            "description": "Scraper id being generated"
          },
          {
            "key": "status",
            "optional": false,
            "type": "string",
            "description": "Build status, generating"
          }
        ]
      }
    },
    {
      "path": "parsera.api.agent.getScraper",
      "shortPath": "agent.getScraper",
      "description": "Read one agentic scraper with its build status and parameters schema",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "scraperId",
            "optional": false,
            "type": "string",
            "description": "Scraper id"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "template_id",
            "optional": false,
            "type": "string",
            "description": "Scraper id"
          },
          {
            "key": "type",
            "optional": true,
            "type": "string | null",
            "description": "Scraper type, agentic"
          },
          {
            "key": "status",
            "optional": false,
            "type": "generating | ready | failed",
            "description": "Build status"
          },
          {
            "key": "name",
            "optional": true,
            "type": "string | null",
            "description": "Scraper name"
          },
          {
            "key": "url",
            "optional": true,
            "type": "string | null",
            "description": "Primary URL the scraper was built on"
          },
          {
            "key": "sample_data",
            "optional": true,
            "type": "Record<string, any>[] | null",
            "description": "Data captured while the agent learned the page"
          },
          {
            "key": "parameters_schema",
            "optional": true,
            "type": "{ name: string, type?: string | null, description?: string | null }[] | null",
            "description": "Parameters the scraper accepts on each run"
          },
          {
            "key": "credits_charged",
            "optional": true,
            "type": "number | null",
            "description": "Credits charged for the build"
          }
        ]
      }
    },
