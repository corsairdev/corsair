          },
          {
            "key": "completed",
            "optional": true,
            "type": "number | null",
            "description": "URLs processed so far (async runs)"
          },
          {
            "key": "total",
            "optional": true,
            "type": "number | null",
            "description": "Total URLs in the run (async runs)"
          },
          {
            "key": "credits_charged",
