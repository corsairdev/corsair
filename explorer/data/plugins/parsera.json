    {
      "path": "parsera.api.extractor.extract",
      "shortPath": "extractor.extract",
      "description": "Extract structured data from a URL with the LLM extractor; each call charges credits",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "prompt",
            "optional": true,
            "type": "string",
            "description": "Prompt that adds context to the attributes"
          },
          {
            "key": "attributes",
            "optional": false,
            "type": "{ name: string, description: string }[]",
