    {
      "path": "parsera.api.scrapers.getRun",
      "shortPath": "scrapers.getRun",
      "description": "Read one async scraper run with its progress and results",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "runId",
            "optional": false,
            "type": "string",
            "description": "Run id"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "run_id",
            "optional": true,
            "type": "string | null",
            "description": "Run id, present when the API deferred the run (202)"
          },
          {
            "key": "status",
            "optional": false,
            "type": "string",
            "description": "queued or running while in progress; completed or completed_partial with data when done (async); the sync run answers the results"
          },
          {
            "key": "completed",
            "optional": true,
            "type": "number | null",
            "description": "URLs processed so far (async runs)"
          },
          {
            "key": "total",
            "optional": true,
            "type": "number | null",
            "description": "Total URLs in the run (async runs)"
          },
          {
            "key": "credits_charged",
            "optional": true,
            "type": "number | null",
            "description": "Credits charged for the run"
          },
          {
            "key": "data",
            "optional": true,
            "type": "Record<string, Record<string, any>[]> | null",
            "description": "Extracted records keyed by scraped URL"
          }
        ]
      }
    },
    {
      "path": "parsera.api.scrapers.run",
      "shortPath": "scrapers.run",
      "description": "Run a scraper and wait for results; the API defers past five minutes to a pollable run",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "template_id",
            "optional": false,
            "type": "string",
            "description": "Scraper id to run"
          },
          {
            "key": "url",
            "optional": true,
            "type": "string | string[]",
            "description": "URL to scrape; extractor scrapers accept an array of up to 100 URLs, agentic scrapers a single URL. Falls back to the scraper default when omitted"
          },
          {
            "key": "parameters",
            "optional": true,
            "type": "Record<string, any>",
            "description": "Custom parameters for agentic scrapers that define a parameters_schema"
          },
          {
            "key": "callback_url",
            "optional": true,
            "type": "string",
            "description": "URL to POST results to when the run completes"
          },
          {
            "key": "proxy_country",
            "optional": true,
            "type": "string",
            "description": "Proxy country, e.g. \"Germany\" or \"UnitedStates\""
          },
          {
            "key": "cookies",
            "optional": true,
            "type": "Record<string, any>[]",
            "description": "Cookies to use; ignored for agentic scrapers"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "run_id",
