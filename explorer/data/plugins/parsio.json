          },
          {
            "key": "page",
            "optional": true,
            "type": "number",
            "description": "Page number"
          },
          {
            "key": "from",
            "optional": true,
            "type": "string",
            "description": "Start date in YYYY-MM-DD format"
          },
          {
            "key": "to",
            "optional": true,
            "type": "string",
            "description": "End date in YYYY-MM-DD format"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "docs",
            "optional": false,
            "type": "{ doc_id?: string | null }[]",
            "description": "The parsed data records on this page"
          },
          {
            "key": "docIds",
            "optional": true,
            "type": "string[] | null",
            "description": "Ids of the documents on this page"
          },
          {
            "key": "totalDocs",
            "optional": true,
            "type": "number | null",
            "description": "Documents in total"
          },
          {
            "key": "limit",
            "optional": true,
            "type": "number | null",
            "description": "Page size"
          },
          {
            "key": "page",
            "optional": true,
            "type": "number | null",
            "description": "Current page"
          },
          {
            "key": "totalPages",
            "optional": true,
            "type": "number | null",
            "description": "Pages in total"
          },
          {
            "key": "hasNextPage",
