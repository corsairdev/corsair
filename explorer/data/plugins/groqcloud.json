      "shortPath": "chat.createCompletion",
      "description": "Generate a chat completion from a list of messages",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "model",
            "optional": false,
            "type": "string",
            "description": "The ID of the model to use"
          },
          {
            "key": "messages",
            "optional": false,
            "type": "{ role: system | user | assistant | tool, content: string | any[], name?: string, tool_call_id?: string }[]",
            "description": "A list of messages comprising the conversation so far"
          },
          {
            "key": "temperature",
            "optional": true,
            "type": "number",
            "description": "Sampling temperature"
          },
          {
            "key": "max_completion_tokens",
            "optional": true,
            "type": "number",
            "description": "The maximum number of tokens to generate"
          },
          {
            "key": "top_p",
            "optional": true,
            "type": "number",
            "description": "Nucleus sampling parameter"
          },
          {
            "key": "stop",
            "optional": true,
            "type": "string | string[]",
            "description": "Up to 4 sequences where the API will stop generating further tokens"
          },
          {
            "key": "stream",
            "optional": true,
            "type": "false",
            "description": "Streaming is not supported by this plugin. The shared transport buffers text/event-stream as plain text, so a streamed call would return a raw SSE string rather than the completion object this operation promises."
          },
          {
            "key": "response_format",
            "optional": true,
            "type": "{ type: string }",
            "description": "Response format object"
          },
          {
            "key": "tools",
            "optional": true,
            "type": "any[]",
            "description": "A list of tools the model may call"
          },
          {
            "key": "tool_choice",
            "optional": true,
            "type": "any",
            "description": "Controls which tool is called by the model"
          }
        ]
      },
