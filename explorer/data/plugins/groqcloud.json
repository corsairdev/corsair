    {
      "path": "groqcloud.api.audio.createTranscription",
      "shortPath": "audio.createTranscription",
      "description": "Transcribe an audio file into text",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "file",
            "optional": true,
            "type": "custom",
            "description": "The audio data to transcribe"
          },
          {
            "key": "fileName",
            "optional": true,
            "type": "string",
            "description": "File name for the uploaded audio; required with `file`"
          },
          {
            "key": "url",
            "optional": true,
            "type": "string",
            "description": "Publicly reachable URL of the audio to transcribe"
          },
          {
            "key": "model",
            "optional": false,
            "type": "string",
            "description": "The ID of the model to use"
          },
          {
            "key": "language",
            "optional": true,
            "type": "string",
            "description": "The language of the input audio"
          },
          {
            "key": "prompt",
            "optional": true,
            "type": "string",
            "description": "An optional text to guide the model"
          },
          {
            "key": "response_format",
            "optional": true,
            "type": "json | text | verbose_json",
            "description": "Transcript output format. Groq accepts only json, text and verbose_json — srt and vtt are rejected with HTTP 400."
          },
          {
            "key": "temperature",
            "optional": true,
            "type": "number",
            "description": "The sampling temperature"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "text",
            "optional": false,
            "type": "string",
            "description": "The transcribed text"
          }
        ]
      }
    },
