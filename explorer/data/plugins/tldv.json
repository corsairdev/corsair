      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": false,
            "type": "string"
          },
          {
            "key": "name",
            "optional": false,
            "type": "string"
          },
          {
            "key": "happenedAt",
            "optional": false,
            "type": "string",
            "description": "When the meeting happened"
          },
          {
            "key": "url",
            "optional": false,
            "type": "string",
            "description": "Console URL for the meeting"
          },
          {
            "key": "duration",
            "optional": false,
            "type": "number",
            "description": "Length in seconds"
          },
          {
            "key": "organizer",
            "optional": false,
            "type": "{ name?: string | null, email: string }"
