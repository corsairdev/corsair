{
  "id": "tldv",
  "displayName": "tl;dv",
  "description": "Meeting intelligence with tl;dv - list and read recorded meetings, pull transcripts and AI notes, import a recording from a URL, and search folders.",
  "npmPackageName": "@corsair-dev/tldv",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 6,
    "webhooks": 2,
    "db": 0
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": [
        "api_key",
        "webhook_signature",
        "webhook_signature",
        "tenant_external_id"
      ]
    }
  ],
  "api": [
    {
      "path": "tldv.api.folders.list",
      "shortPath": "folders.list",
      "description": "Search the folders a user can see, with their meeting ids",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "query",
            "optional": true,
            "type": "string",
            "description": "Folder name to search for"
          },
          {
            "key": "meetingIds",
            "optional": true,
            "type": "string[]",
            "description": "Folders must contain these meeting ids"
          },
          {
            "key": "meetingIdsOp",
            "optional": true,
            "type": "and | or",
            "description": "Whether a folder must contain every id or any"
          },
          {
            "key": "space",
            "optional": true,
            "type": "all | personal | team | organization",
            "description": "Which folder scopes to search"
          },
          {
            "key": "page",
            "optional": true,
            "type": "number"
          },
          {
            "key": "limit",
            "optional": true,
            "type": "number"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "page",
            "optional": false,
            "type": "number",
            "description": "Current page number"
          },
          {
            "key": "pages",
            "optional": false,
            "type": "number",
            "description": "Total pages available"
          },
          {
            "key": "total",
            "optional": false,
            "type": "number",
            "description": "Total results available"
          },
          {
            "key": "pageSize",
            "optional": false,
            "type": "number",
            "description": "Results per page"
          },
          {
            "key": "results",
            "optional": false,
            "type": "{ id: string, name: string, meetingIds: string[] }[]"
          }
        ]
      }
    },
    {
      "path": "tldv.api.meetings.get",
      "shortPath": "meetings.get",
      "description": "Get one meeting by id, including the phone number and metadata an import attached",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "meetingId",
