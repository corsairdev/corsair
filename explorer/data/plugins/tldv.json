        "kind": "object",
        "fields": [
          {
            "key": "page",
            "optional": false,
            "type": "number",
            "description": "Current page number"
          },
          {
            "key": "pages",
            "optional": false,
            "type": "number",
            "description": "Total pages available"
          },
          {
            "key": "total",
            "optional": false,
            "type": "number",
            "description": "Total results available"
          },
          {
            "key": "pageSize",
            "optional": false,
            "type": "number",
            "description": "Results per page"
          },
          {
            "key": "results",
            "optional": false,
            "type": "{ id: string, name: string, happenedAt: string, url: string, duration: number, organizer: { name?: string | null, email: string }, invitees: { name?: string | null, email: string }[], template?: { id?: string | null, label?: string | null } | null, extraProperties?: { conferenceId?: string | null } | null, phoneNumber?: string | null, metadata?: Record<string, any> | null }[]"
          }
        ]
