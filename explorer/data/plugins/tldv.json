    },
    {
      "path": "tldv.api.meetings.import",
      "shortPath": "meetings.import",
      "description": "Import a meeting from a public media URL, which starts a processing job and spends recording minutes",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "url",
            "optional": false,
            "type": "string",
            "description": "Publicly reachable media URL. Supported: .mp3 .mp4 .wav .m4a .mkv .mov .avi .wma .flac"
          },
          {
            "key": "name",
            "optional": false,
            "type": "string",
            "description": "Name for the new meeting"
          },
          {
            "key": "happenedAt",
            "optional": true,
            "type": "string",
            "description": "Meeting date, ISO 8601 with milliseconds"
          },
          {
            "key": "participants",
            "optional": true,
            "type": "string[]",
            "description": "Emails of the invited participants"
          },
          {
            "key": "phoneNumber",
            "optional": true,
            "type": "string"
          },
          {
            "key": "metadata",
            "optional": true,
            "type": "Record<string, string | number | boolean>",
            "description": "Flat key/value map with your own identifiers: up to 20 keys, values are strings, numbers or booleans"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "success",
            "optional": false,
            "type": "boolean"
          },
          {
            "key": "jobId",
            "optional": false,
            "type": "string",
            "description": "Id of the import job"
          },
          {
            "key": "message",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "tldv.api.meetings.list",
      "shortPath": "meetings.list",
