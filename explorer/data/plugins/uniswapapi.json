      "path": "uniswapapi.api.swap.create",
      "shortPath": "swap.create",
      "description": "Create swap calldata (unsigned transaction) for broadcast",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "quote",
            "optional": false,
            "type": "{}",
