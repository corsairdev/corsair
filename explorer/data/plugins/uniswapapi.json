      "path": "uniswapapi.api.approval.check",
      "shortPath": "approval.check",
      "description": "Check if a wallet has the required token approval for a swap",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "token",
            "optional": false,
            "type": "string",
            "description": "Token contract address"
          },
          {
            "key": "amount",
            "optional": false,
            "type": "string",
            "description": "Amount to check approval for"
          },
          {
            "key": "walletAddress",
            "optional": false,
            "type": "string",
            "description": "Wallet address to check"
          },
          {
            "key": "chainId",
            "optional": false,
            "type": "number",
            "description": "Chain ID"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "requestId",
            "optional": false,
            "type": "string"
          },
          {
            "key": "approval",
            "optional": true,
            "type": "{ to: string, from?: string, data: string, value: string, chainId: number, gasLimit?: string, maxFeePerGas?: string, maxPriorityFeePerGas?: string, gasPrice?: string }"
