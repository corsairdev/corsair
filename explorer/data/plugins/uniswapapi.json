            "key": "requestId",
            "optional": false,
            "type": "string"
          },
          {
            "key": "orders",
            "optional": false,
            "type": "{ orderId: string, orderStatus: open | expired | error | cancelled | filled | unverified | insufficient-funds, chainId: number, type: DutchLimit | Dutch | Dutch_V2 | Dutch_V3 | Priority, encodedOrder?: string, signature?: string, nonce?: string, quoteId?: string, swapper?: string, txHash?: string }[]"
