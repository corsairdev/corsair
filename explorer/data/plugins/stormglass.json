            "key": "end",
            "optional": true,
            "type": "string | number",
            "description": "Last hour, UTC. UNIX seconds or ISO. At most 10 days after start."
          },
          {
            "key": "datum",
            "optional": true,
            "type": "HAT | MHHW | MHW | MSL | MLW | MLLW | LAT",
            "description": "Reference level the heights are relative to. Stormglass defaults to MSL."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
