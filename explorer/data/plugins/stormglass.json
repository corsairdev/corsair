  "description": "Global weather, marine, tide, astronomy, solar, bio and elevation data for any coordinate, from the Stormglass API.",
  "npmPackageName": "@corsair-dev/stormglass",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 10,
