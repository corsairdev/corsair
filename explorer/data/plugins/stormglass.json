  "api": [
    {
      "path": "stormglass.api.astronomy.get",
      "shortPath": "astronomy.get",
      "description": "Get sunrise, sunset, dawn, dusk, moonrise, moonset and moon phase per day for one coordinate.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "lat",
            "optional": false,
            "type": "number"
          },
          {
            "key": "lng",
            "optional": false,
            "type": "number"
          },
          {
            "key": "start",
            "optional": true,
            "type": "string | number",
            "description": "First hour, UTC. UNIX seconds or ISO (2024-01-01 or 2024-01-01T06)."
          },
          {
            "key": "end",
            "optional": true,
            "type": "string | number",
            "description": "Last hour, UTC. UNIX seconds or ISO. At most 10 days after start."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "days",
            "optional": false,
            "type": "{ time: string, sunrise?: string | null, sunset?: string | null, moonrise?: string | null, moonset?: string | null, moonFraction?: number, moonPhase?: { current?: { text?: string, time?: string, value?: number }, closest?: { text?: string, time?: string, value?: number } }, astronomicalDawn?: string | null, astronomicalDusk?: string | null, civilDawn?: string | null, civilDusk?: string | null, nauticalDawn?: string | null, nauticalDusk?: string | null }[]"
          },
          {
            "key": "quota",
            "optional": false,
            "type": "{ id: string, dailyQuota?: number, requestCount?: number }"
          }
        ]
      }
    },
    {
      "path": "stormglass.api.bio.get",
