            "optional": true,
            "type": "string | number",
            "description": "Last hour, UTC. UNIX seconds or ISO. At most 10 days after start."
          },
          {
            "key": "source",
            "optional": true,
            "type": "string",
            "description": "Comma-separated sources, e.g. sg or noaa,dwd. The first one fills `values`."
          }
