      "path": "stormglass.api.tides.extremes",
      "shortPath": "tides.extremes",
      "description": "Get high and low tide times and heights near a coordinate, up to 10 days, from the nearest tide station.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "lat",
            "optional": false,
            "type": "number"
          },
          {
            "key": "lng",
            "optional": false,
