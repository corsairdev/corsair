            "key": "list_folder",
            "optional": true,
            "type": "{ accounts: string[] }"
          }
        ]
      },
      "responseType": "{ delta?: { users: number[] }, list_folder?: { accounts: string[] } }",
      "usageExample": "dropbox({\n    webhookHooks: {\n        filesystem: {\n            changed: {\n                before(ctx, args) {\n                    return { ctx, args };\n                },\n                after(ctx, response) {\n                },\n            },\n        },\n    },\n})"
    }
