      "description": "Revoke an API access token; apps using it stop working",
      "riskLevel": "destructive",
      "irreversible": true,
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": false,
            "type": "string",
            "description": "Token id"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": false,
            "type": "string",
            "description": "Revoked token id"
          },
          {
            "key": "success",
            "optional": false,
            "type": "boolean",
            "description": "Whether the revoke succeeded"
          }
        ]
      }
    },
