{
  "id": "passcreator",
  "displayName": "Passcreator",
  "description": "Passcreator is a wallet pass platform for Apple Wallet and Google Wallet. This plugin creates and updates passes from templates with personalised properties, delivers passes by email, pushes notifications to pass holders, reads pass statistics, copies templates, moves passes between templates (API v2), and manages webhook subscriptions whose deliveries carry verifiable ECDSA signatures.",
  "npmPackageName": "@corsair-dev/passcreator",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 21,
    "webhooks": 1,
    "db": 0
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "passcreator.api.passes.activeHistory",
      "shortPath": "passes.activeHistory",
      "description": "Read the history of active and inactive passes of a template",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "templateUid",
            "optional": false,
            "type": "string",
            "description": "Pass-template UID"
          },
          {
            "key": "day",
            "optional": true,
            "type": "string",
            "description": "First day of the history (YYYY-MM-DD); omit for the last seven days"
          }
        ]
      },
      "output": {
        "kind": "inline",
        "type": "{ date: string, active?: number | null, inactive?: number | null }[]"
      }
    },
