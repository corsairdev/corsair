    {
      "path": "passcreator.api.passes.list",
      "shortPath": "passes.list",
      "description": "List the passes of a pass template, paged by cursor and date",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "templateUid",
            "optional": false,
            "type": "string",
            "description": "Pass-template UID to list passes of"
          },
          {
            "key": "start",
            "optional": true,
            "type": "number",
            "description": "Offset of the first pass to return"
          },
          {
            "key": "pageSize",
            "optional": true,
            "type": "number",
            "description": "Number of passes per page (max 100)"
          },
          {
            "key": "lastIdOfPriorPage",
            "optional": true,
            "type": "string",
            "description": "Identifier of the last pass of the prior page, for cursor paging"
          },
          {
            "key": "lastCreatedOnOfPriorPage",
            "optional": true,
            "type": "string",
            "description": "createdOn of the last pass of the prior page, for cursor paging"
          },
          {
            "key": "createdSince",
            "optional": true,
            "type": "string",
            "description": "Only passes created after this date, e.g. \"2021-07-01 15:30\""
          },
          {
            "key": "modifiedSince",
            "optional": true,
            "type": "string",
            "description": "Only passes modified after this date, e.g. \"2021-07-01 15:30\""
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "query",
            "optional": true,
            "type": "{ start?: number | null, pageSize?: number | null, self?: string | null, next?: string | null } | null",
            "description": "The query and its paging links"
          },
          {
            "key": "total",
            "optional": true,
            "type": "number | null",
            "description": "Total passes matching the query"
          },
          {
            "key": "results",
            "optional": false,
            "type": "{ passId?: string | null, identifier?: string | null, uniqueIdentifier?: string | null, barcodeValue?: string | null, linkToPassPage?: string | null, passTemplate?: string | null, passTemplateGuid?: string | null, createdOn?: string | null, voided?: boolean | null }[]",
            "description": "The passes on this page"
          }
        ]
      }
