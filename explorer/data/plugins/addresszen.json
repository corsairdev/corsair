{
  "id": "addresszen",
  "displayName": "AddressZen",
  "description": "Address validation and geocoding API for verifying and standardizing postal addresses.",
  "npmPackageName": "@corsair-dev/addresszen",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 4,
    "webhooks": 0,
    "db": 4
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "addresszen.api.autocomplete.addresses",
      "shortPath": "autocomplete.addresses",
      "description": "Get address autocomplete suggestions for a partial address query",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "query",
            "optional": false,
            "type": "string",
            "description": "Partial address string to autocomplete"
          },
          {
            "key": "limit",
            "optional": true,
            "type": "number"
          },
          {
            "key": "page",
            "optional": true,
            "type": "number"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "code",
            "optional": false,
            "type": "number"
          },
          {
            "key": "message",
            "optional": false,
            "type": "string"
          },
          {
            "key": "result",
            "optional": false,
            "type": "{ hits: { id: string, suggestion: string, urls?: {} | null, udprn?: number }[] }"
          }
        ]
      }
    },
    {
      "path": "addresszen.api.key.availability",
      "shortPath": "key.availability",
      "description": "Get public information on an API key, including whether it is currently usable",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": []
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "code",
            "optional": false,
            "type": "number"
          },
          {
            "key": "message",
            "optional": false,
            "type": "string"
          },
          {
            "key": "result",
            "optional": false,
            "type": "{ available: boolean, context?: string, contexts?: {}[] }"
          }
        ]
      }
    },
    {
      "path": "addresszen.api.resolve.addressUsa",
      "shortPath": "resolve.addressUsa",
      "description": "Resolve an address autocompletion by its address ID and return the full address in US format",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "addressId",
            "optional": false,
            "type": "string",
            "description": "Address suggestion ID from autocomplete (e.g. usps_X130125796|1600||1933)"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "code",
            "optional": false,
            "type": "number"
          },
          {
            "key": "message",
            "optional": false,
            "type": "string"
          },
          {
            "key": "result",
            "optional": false,
            "type": "{ id?: string, line_1?: string, line_2?: string, city?: string, state?: string, state_abbreviation?: string, zip_code?: string, country_iso_2?: string }"
          }
        ]
      }
    },
    {
      "path": "addresszen.api.verify.address",
      "shortPath": "verify.address",
      "description": "Verify and standardize a US address using USPS CASS validation",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "query",
            "optional": false,
            "type": "string",
            "description": "Address to verify. Use a full free-form address, or only the first line when city/state or zip_code are provided separately."
          },
          {
            "key": "zip_code",
            "optional": true,
            "type": "string"
          },
          {
            "key": "city",
            "optional": true,
            "type": "string"
          },
          {
            "key": "state",
            "optional": true,
            "type": "string"
          },
          {
            "key": "context",
            "optional": true,
            "type": "string",
            "description": "Optional metadata tag stored with the lookup"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "code",
            "optional": false,
            "type": "number"
          },
          {
            "key": "message",
            "optional": false,
            "type": "string"
          },
          {
            "key": "result",
            "optional": false,
            "type": "{ query: string, query_city?: string, query_state?: string, query_zip_code?: string, match?: any | null, count?: number, fit?: number, confidence?: number, match_information?: any, address_line_one?: string, address_line_two?: string, city?: string, state?: string, zip_code?: string, country_iso_2?: string }"
          }
        ]
      }
    }
  ],
