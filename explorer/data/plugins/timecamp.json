{
  "id": "timecamp",
  "displayName": "TimeCamp",
  "description": "Automatic time tracking software for projects, attendance, invoicing, and team productivity.",
  "npmPackageName": "@corsair-dev/timecamp",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 1,
    "webhooks": 0,
    "db": 1
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "timecamp.api.projects.getList",
      "shortPath": "projects.getList",
      "description": "List TimeCamp projects (root-level tasks), returning task id, name, archived status, colour, budget information and assigned users",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "include_archived",
            "optional": true,
            "type": "boolean"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "projects",
            "optional": false,
            "type": "{ task_id: string, name: string, archived: boolean, color?: string | null, billable?: boolean | null, budgeted?: number | null, budget_unit?: string | null, note?: string | null, add_date?: string | null, edit_date?: string | null, root_group_id?: string | null, assigned_users: string[] }[]"
          },
          {
            "key": "count",
            "optional": false,
            "type": "number"
          }
        ]
      }
    }
  ],
  "webhooks": [],
  "db": [
    {
      "path": "timecamp.db.projects.search",
      "entityName": "projects",
      "filters": [
        {
          "field": "entity_id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "name",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "archived",
          "type": "boolean",
          "operators": ["equals"]
        },
        {
          "field": "color",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "billable",
          "type": "boolean",
          "operators": ["equals"]
        },
        {
          "field": "budgeted",
          "type": "number",
          "operators": ["equals", "gt", "gte", "lt", "lte", "in"]
        },
        {
          "field": "budget_unit",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "root_group_id",
          "type": "string",
          "operators": ["equals", "contains", "startsWith", "endsWith", "in"]
        },
        {
          "field": "createdAt",
          "type": "date",
          "operators": ["equals", "before", "after", "between"]
        }
      ]
    }
  ]
}
