      "path": "ollama.api.chat.chat",
      "shortPath": "chat.chat",
      "description": "Tool to send a chat message with conversation history to Ollama. Use when you need to have a multi-turn conversation with an LLM model.",
      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "model",
            "optional": false,
            "type": "string",
            "description": "Name of the model to use for chat"
          },
          {
            "key": "messages",
            "optional": false,
            "type": "{ role: string, content: string, images?: string[], tool_calls?: any[] }[]",
            "description": "Conversation history"
          },
          {
            "key": "tools",
            "optional": true,
            "type": "any[]",
            "description": "List of tools/functions available to the model"
          },
          {
            "key": "format",
            "optional": true,
            "type": "string | {}",
            "description": "Output format, e.g. \"json\" or a JSON schema"
          },
          {
            "key": "options",
            "optional": true,
            "type": "{}",
            "description": "Model configuration options (temperature, top_p, etc.)"
          },
          {
            "key": "stream",
            "optional": true,
            "type": "boolean",
            "description": "Whether to stream responses (default false)"
          },
          {
            "key": "keep_alive",
            "optional": true,
            "type": "string | number",
            "description": "Duration to keep the model loaded in memory"
          }
