            "type": "({ type: search, input: { q: string, depth: flash | fast | standard | deep, outputType: searchResults | sourcedAnswer | structured } } | { type: fetch, input: { url: string } } | { type: research, input: { q: string, outputType: sourcedAnswer | structured } })[]"
