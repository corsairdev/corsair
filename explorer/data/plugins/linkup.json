      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "tasks",
            "optional": false,
            "type": "{ id: string, type?: string, status: string, createdAt?: string, updatedAt?: string, error?: string | null, input?: Record<string, any>, output?: any }[]"
          },
          {
            "key": "meta",
            "optional": true,
            "type": "{ page?: number, pageSize?: number, total?: number, totalPages?: number }"
          },
          {
            "key": "quota",
            "optional": true,
            "type": "{ inFlight?: number, limit?: number }"
          }
