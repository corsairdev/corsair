{
  "id": "linkup",
  "displayName": "Linkup",
  "description": "Web search for AI agents with Linkup - search results with page text, sourced answers, structured JSON, page fetch, and async research tasks.",
  "npmPackageName": "@corsair-dev/linkup",
  "authTypes": ["api_key"],
  "defaultAuthType": "api_key",
  "counts": {
    "api": 12,
    "webhooks": 0,
    "db": 3
  },
  "auth": [
    {
      "authType": "api_key",
      "integrationFields": [],
      "accountFields": ["api_key", "webhook_signature"]
    }
  ],
  "api": [
    {
      "path": "linkup.api.answers.get",
      "shortPath": "answers.get",
      "description": "Search the web and return a written answer with its sources ($0.006; deep $0.055).",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "q",
            "optional": false,
            "type": "string"
          },
          {
            "key": "depth",
            "optional": true,
            "type": "flash | fast | standard | deep",
            "description": "flash, fast and standard cost the same and get slower and broader in that order; deep runs several searches and costs 10x. Default fast."
          },
          {
            "key": "includeInlineCitations",
            "optional": true,
            "type": "boolean",
            "description": "Put numbered citations inside the answer text."
          },
          {
            "key": "fromDate",
            "optional": true,
            "type": "string",
            "description": "Only sources published on or after this date (YYYY-MM-DD)."
          },
          {
            "key": "toDate",
            "optional": true,
            "type": "string",
            "description": "Only sources published on or before this date (YYYY-MM-DD)."
          },
          {
            "key": "includeDomains",
            "optional": true,
            "type": "string[]",
            "description": "Only search these domains."
          },
          {
            "key": "excludeDomains",
            "optional": true,
            "type": "string[]",
            "description": "Never return these domains."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "answer",
            "optional": false,
            "type": "string"
          },
          {
            "key": "sources",
            "optional": false,
            "type": "{ name?: string, url: string, snippet?: string, favicon?: string | null, publishedAt?: string }[]"
          }
        ]
      }
    },
    {
      "path": "linkup.api.credits.get",
      "shortPath": "credits.get",
      "description": "Get the account's remaining credit balance in dollars.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": []
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "credit",
            "optional": false,
            "type": "{ id: balance, balance: number }"
          }
        ]
      }
    },
    {
      "path": "linkup.api.pages.fetch",
      "shortPath": "pages.fetch",
      "description": "Fetch one web page or PDF as markdown, optionally with typed data from a schema ($0.001 to $0.011).",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "url",
            "optional": false,
            "type": "string"
          },
          {
            "key": "mode",
            "optional": true,
            "type": "standard | pro",
            "description": "pro gets past harder pages and costs 5x. Default standard."
          },
          {
            "key": "renderJs",
            "optional": true,
            "type": "boolean",
            "description": "Run the page's JavaScript before reading it (costs 5x)."
          },
          {
            "key": "extractImages",
            "optional": true,
            "type": "boolean"
          },
          {
            "key": "includeRawContent",
            "optional": true,
            "type": "boolean",
            "description": "Also return the page's raw text."
          },
          {
            "key": "schema",
            "optional": true,
            "type": "Record<string, any>",
            "description": "JSON Schema for typed data to pull from the page."
          },
          {
            "key": "instructions",
            "optional": true,
            "type": "string",
            "description": "What to pull from the page, used with schema."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "markdown",
            "optional": false,
            "type": "string"
          },
          {
            "key": "data",
            "optional": true,
            "type": "Record<string, any>"
          },
          {
            "key": "rawContent",
            "optional": true,
            "type": "string"
          },
          {
            "key": "images",
            "optional": true,
            "type": "any[]"
          },
          {
            "key": "contentType",
            "optional": true,
            "type": "string"
          }
        ]
      }
    },
    {
      "path": "linkup.api.research.create",
      "shortPath": "research.create",
      "description": "Start a multi-step research task ($0.25 to $2.50 by reasoningDepth). Poll research.get for the result.",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "q",
            "optional": false,
            "type": "string",
            "description": "The research question."
          },
          {
            "key": "reasoningDepth",
            "optional": true,
            "type": "S | M | L | XL",
            "description": "How hard to work: S $0.25 (default here), M $0.50, L $1.50, XL $2.50 per task."
          },
          {
            "key": "mode",
            "optional": true,
            "type": "auto | answer | investigate | research"
          },
          {
            "key": "outputType",
            "optional": true,
            "type": "sourcedAnswer | structured"
          },
          {
            "key": "schema",
            "optional": true,
            "type": "Record<string, any>",
            "description": "JSON Schema for structured output; needed when outputType is structured."
          },
          {
            "key": "fromDate",
            "optional": true,
            "type": "string",
            "description": "Only sources published on or after this date (YYYY-MM-DD)."
          },
          {
            "key": "toDate",
            "optional": true,
            "type": "string",
            "description": "Only sources published on or before this date (YYYY-MM-DD)."
          },
          {
            "key": "includeDomains",
            "optional": true,
            "type": "string[]",
            "description": "Only search these domains."
          },
          {
            "key": "excludeDomains",
            "optional": true,
            "type": "string[]",
            "description": "Never return these domains."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "task",
            "optional": false,
            "type": "{ id: string, type?: string, status: string, createdAt?: string, updatedAt?: string, error?: string | null, input?: Record<string, any>, output?: any }"
          }
        ]
      }
    },
    {
      "path": "linkup.api.research.get",
      "shortPath": "research.get",
      "description": "Get a research task: status, and the answer or structured data once completed.",
      "riskLevel": "read",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "id",
            "optional": false,
            "type": "string"
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "task",
            "optional": false,
            "type": "{ id: string, type?: string, status: string, createdAt?: string, updatedAt?: string, error?: string | null, input?: Record<string, any>, output?: any }"
          }
        ]
      }
    },
    {
      "path": "linkup.api.research.list",
      "shortPath": "research.list",
