    },
    {
      "path": "linkup.api.responses.create",
      "shortPath": "responses.create",
      "description": "Generate an answer grounded in live web results (OpenAI Responses format). Paid generation.",
      "riskLevel": "destructive",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "input",
            "optional": false,
            "type": "string"
          },
          {
            "key": "model",
            "optional": false,
            "type": "linkup-standard | linkup-deep",
            "description": "linkup-standard is faster; linkup-deep is more thorough."
          },
          {
            "key": "instructions",
            "optional": true,
            "type": "string",
            "description": "System-style instructions for the answer."
          }
        ]
      },
      "output": {
        "kind": "object",
        "fields": [
          {
            "key": "response",
            "optional": false,
            "type": "{ id: string, model?: string, object?: string }"
          },
          {
            "key": "outputText",
            "optional": false,
            "type": "string"
          }
        ]
      }
    },
    {
