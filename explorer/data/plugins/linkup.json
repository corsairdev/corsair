          },
          {
            "key": "includeSources",
            "optional": true,
            "type": "boolean",
            "description": "Also return the sources the data came from."
          },
          {
            "key": "fromDate",
            "optional": true,
            "type": "string",
            "description": "Only sources published on or after this date (YYYY-MM-DD)."
          },
          {
            "key": "toDate",
            "optional": true,
            "type": "string",
