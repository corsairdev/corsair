            "optional": false,
            "type": "string",
            "description": "What to search for, in plain language."
          },
          {
            "key": "depth",
            "optional": true,
            "type": "flash | fast | standard | deep",
            "description": "flash, fast and standard cost the same and get slower and broader in that order; deep runs several searches and costs 10x. Default fast."
          },
          {
            "key": "maxResults",
            "optional": true,
            "type": "number"
          },
          {
            "key": "includeImages",
            "optional": true,
            "type": "boolean",
            "description": "Also return image results."
          },
          {
            "key": "fromDate",
            "optional": true,
            "type": "string",
            "description": "Only sources published on or after this date (YYYY-MM-DD)."
          },
          {
            "key": "toDate",
            "optional": true,
            "type": "string",
            "description": "Only sources published on or before this date (YYYY-MM-DD)."
          },
          {
            "key": "includeDomains",
            "optional": true,
            "type": "string[]",
            "description": "Only search these domains."
          },
          {
            "key": "excludeDomains",
            "optional": true,
            "type": "string[]",
            "description": "Never return these domains."
