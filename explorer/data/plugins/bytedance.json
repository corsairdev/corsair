      "riskLevel": "write",
      "input": {
        "kind": "object",
        "fields": [
          {
            "key": "model",
            "optional": false,
            "type": "string",
            "description": "Model ID (dreamina-seedance-2-5-260628, dreamina-seedance-2-0-260128, dreamina-seedance-2-0-fast-260128, dreamina-seedance-2-0-mini-260615, seedance-1-5-pro-251215, seedance-1-0-pro-250528, seedance-1-0-pro-fast-251015) or an inference endpoint ID"
          },
          {
            "key": "content",
            "optional": false,
            "type": "({ type: text, text: string } | { type: image_url, image_url: { url: string }, role?: first_frame | last_frame | reference_image } | { type: video_url, video_url: { url: string }, role: reference_video } | { type: audio_url, audio_url: { url: string }, role: reference_audio } | { type: draft_task, draft_task: { id: string } })[]"
          },
          {
            "key": "omni_reference_task_type",
            "optional": true,
            "type": "auto | reference | edit | extend"
          },
          {
            "key": "resolution",
            "optional": true,
            "type": "480p | 720p | 1080p | 4k"
          },
          {
            "key": "ratio",
