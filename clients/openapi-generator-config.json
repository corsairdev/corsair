{
  "$schema": "https://raw.githubusercontent.com/OpenAPITools/openapi-generator/master/modules/openapi-generator/src/main/resources/config-schema.json",
  "inputSpec": "packages/corsair/core/cloud/contract.openapi.yaml",
  "generators": {
    "python": {
      "generatorName": "python",
      "output": "clients/python",
      "packageName": "corsair_cloud"
    },
    "go": {
      "generatorName": "go",
      "output": "clients/go",
      "packageName": "corsaircloud"
    },
    "swift": {
      "generatorName": "swift5",
      "output": "clients/swift",
      "packageName": "CorsairCloud"
    }
  }
}
