{
  "name": "@corsair-dev/llamaindex",
  "version": "0.1.0",
  "description": "Corsair tools for LlamaIndex.TS — expose 200+ integrations to your agents with managed OAuth and credentials that stay in your own database.",
  "keywords": [
    "llamaindex",
    "llamaindex-ts",
    "ai-agents",
    "tools",
    "tool-calling",
    "integrations",
    "managed-oauth",
    "corsair"
  ],
  "author": "Corsair (https://corsair.dev)",
  "license": "Apache-2.0",
  "homepage": "https://corsair.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corsairdev/corsair.git",
    "directory": "adapters/llamaindex"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=dev-source src/index.check.ts"
  },
  "dependencies": {
    "corsair": "workspace:*"
  },
  "peerDependencies": {
    "@llamaindex/core": "^0.6.23"
  },
  "peerDependenciesMeta": {
    "@llamaindex/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@llamaindex/core": "^0.6.23",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0",
    "zod": "^4.4.3"
  },
  "files": [
    "dist"
  ]
}
